---
import InterruptorTema from './InterruptorTema.astro'
import SelectorIdioma from './SelectorIdioma.astro'
import { idiomaDe, enlace, t } from '../i18n'
const idioma = idiomaDe(Astro.url)
const menu = t(idioma, {
  en: { inicio: 'home', about: 'About', contacto: 'Contact', principal: 'Main' },
  de: { inicio: 'Startseite', about: 'Über mich', contacto: 'Kontakt', principal: 'Hauptmenü' },
  es: { inicio: 'inicio', about: 'Sobre mí', contacto: 'Contacto', principal: 'Menú principal' },
})
---

<header class="cabecera contenedor">
  <a class="logo" href={enlace(idioma, '/')} aria-label={`Camilo Cepeda Danies — ${menu.inicio}`}><b>camilo</b><span>cepeda</span><b>danies</b></a>
  <nav aria-label={menu.principal}>
    <a href={enlace(idioma, '/#software')}>Software</a>
    <a href={enlace(idioma, '/#design')}>Design</a>
    <a href={enlace(idioma, '/#about')}>{menu.about}</a>
    <a class="pildora pildora--llena contacto" href={enlace(idioma, '/#contact')}>{menu.contacto}</a>
  </nav>
  <div class="ajustes">
    <SelectorIdioma />
    <InterruptorTema />
  </div>
</header>

<script>
  // En el móvil el header se esconde al bajar (para leer los casos sin distracciones) y vuelve al subir.
  // Solo pone/quita la clase "cabecera-oculta" en <html>; el CSS decide que solo afecte a pantallas pequeñas.
  const html = document.documentElement
  let anterior = scrollY
  addEventListener('scroll', () => {
    const y = scrollY
    if (y < 120) html.classList.remove('cabecera-oculta')
    else if (y > anterior + 6) html.classList.add('cabecera-oculta')
    else if (y < anterior - 6) html.classList.remove('cabecera-oculta')
    anterior = y
  }, { passive: true })
</script>

<style>
  /* Fija arriba en toda la página. Su fondo usa el token, así cambia sola en Dark y en "modo cine" */
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--alto-cabecera);
    display: flex;
    align-items: center;
    gap: var(--espacio-5);
    background: var(--color-fondo);
    transition: background-color 0.7s ease;
  }
  /* la barra ocupa todo el ancho aunque el contenido vaya centrado.
     Se pinta con una sombra (no con un bloque más ancho): así la página no se vuelve más ancha que el móvil */
  .cabecera::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: var(--color-fondo); box-shadow: 0 0 0 100vmax var(--color-fondo); clip-path: inset(0 -100vmax);
    transition: background-color 0.7s ease, box-shadow 0.7s ease;
  }
  /* Firma: camilo y danies gruesos, cepeda fino (el estilo del logo de siempre) */
  .logo b { font-weight: 700; }
  .logo span { font-weight: 300; }
  .logo {
    font-family: var(--fuente-mono);
    font-size: var(--texto-s);
    font-weight: var(--peso-medio);
    text-decoration: none;
    margin-right: auto;
  }
  nav { display: flex; align-items: center; gap: var(--espacio-5); font-size: var(--texto-s); }
  nav a:not(.pildora) { text-decoration: none; }
  .contacto { min-height: 40px; padding: var(--espacio-2) var(--espacio-4); font-size: var(--texto-s); }
  /* idioma + sol/luna, juntos a la derecha */
  .ajustes { display: flex; align-items: center; gap: var(--espacio-2); }

  @media (max-width: 900px) {
    .cabecera { transition: transform 0.35s ease, background-color 0.7s ease; }
    :global(html.cabecera-oculta) .cabecera { transform: translateY(-100%); }
  }
  @media (max-width: 720px) {
    .cabecera { flex-wrap: wrap; align-content: center; gap: var(--espacio-3) var(--espacio-4); }
    nav { order: 3; width: 100%; justify-content: space-between; gap: var(--espacio-3); }
    .ajustes { gap: var(--espacio-1); }
  }
  /* móviles estrechos: el logo un pelín más pequeño para que quepa con idioma + sol/luna */
  @media (max-width: 380px) { .logo { font-size: 0.75rem; } .cabecera { column-gap: var(--espacio-2); } }
</style>
