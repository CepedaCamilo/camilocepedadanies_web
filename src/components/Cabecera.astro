---
import InterruptorTema from './InterruptorTema.astro'
---

<header class="cabecera contenedor">
  <a class="logo" href="/" aria-label="Camilo Cepeda Danies — home"><b>camilo</b><span>cepeda</span><b>danies</b></a>
  <nav aria-label="Main">
    <a href="/#software">Software</a>
    <a href="/#design">Design</a>
    <a href="/#about">About</a>
    <a class="pildora pildora--llena contacto" href="/#contact">Contact</a>
  </nav>
  <InterruptorTema />
</header>

<style>
  /* Fija arriba en toda la página. Su fondo usa el token, así cambia sola en Dark y en "modo cine" */
  .cabecera {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--alto-cabecera);
    display: flex;
    align-items: center;
    gap: var(--espacio-5);
    background: var(--color-fondo);
    transition: background-color 0.7s ease;
  }
  /* la barra ocupa todo el ancho aunque el contenido vaya centrado.
     Se pinta con una sombra (no con un bloque más ancho): así la página no se vuelve más ancha que el móvil */
  .cabecera::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: var(--color-fondo); box-shadow: 0 0 0 100vmax var(--color-fondo); clip-path: inset(0 -100vmax);
    transition: background-color 0.7s ease, box-shadow 0.7s ease;
  }
  /* Firma: camilo y danies gruesos, cepeda fino (el estilo del logo de siempre) */
  .logo b { font-weight: 700; }
  .logo span { font-weight: 300; }
  .logo {
    font-family: var(--fuente-mono);
    font-size: var(--texto-s);
    font-weight: var(--peso-medio);
    text-decoration: none;
    margin-right: auto;
  }
  nav { display: flex; align-items: center; gap: var(--espacio-5); font-size: var(--texto-s); }
  nav a:not(.pildora) { text-decoration: none; }
  .contacto { min-height: 40px; padding: var(--espacio-2) var(--espacio-4); font-size: var(--texto-s); }

  @media (max-width: 720px) {
    .cabecera { flex-wrap: wrap; align-content: center; gap: var(--espacio-3) var(--espacio-4); }
    nav { order: 3; width: 100%; justify-content: space-between; gap: var(--espacio-3); }
  }
</style>
