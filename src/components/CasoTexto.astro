---
// El texto largo de un caso de "Selected work": párrafos, ficha (Role / Stack / Scope…), botones y, si hace falta, un aviso legal.
// Se usa DOS veces en cada caso:
//   - enEscena: junto a la animación (ordenador). En el móvil se oculta dentro de la escena fija…
//   - …y se muestra debajo de la animación, en <div class="detalle-movil"> (así el móvil también lee todo el texto).
// Las reglas para mostrar/ocultar están en global.css (sección "Casos en el móvil").
interface Accion { texto: string; href: string; llena?: boolean; siguiente?: boolean; externo?: boolean }
interface Props {
  entradilla: string
  suave?: string
  ficha: [string, string][]
  acciones: Accion[]
  aviso?: string
  enEscena?: boolean
}
const { entradilla, suave, ficha, acciones, aviso, enEscena = false } = Astro.props
---

<div class:list={['caso-texto', { 'caso-texto--escena': enEscena }]}>
  <p class="entradilla">{entradilla}</p>
  {suave && <p class="texto-suave">{suave}</p>}
  <dl class="ficha">
    {ficha.map(([dt, dd]) => <div><dt>{dt}</dt><dd>{dd}</dd></div>)}
  </dl>
  <div class="acciones">
    {
      acciones.map((a) => (
        <a
          class:list={['pildora', { 'pildora--llena': a.llena }]}
          href={a.href}
          data-siguiente={a.siguiente ? '' : undefined}
          rel={a.externo ? 'noopener' : undefined}
        >
          {a.texto}
        </a>
      ))
    }
  </div>
  {aviso && <p class="aviso-legal">{aviso}</p>}
</div>

<style>
  .caso-texto { display: flex; flex-direction: column; gap: var(--espacio-4); }
  .entradilla { margin: 0; }
  .texto-suave { margin: 0; color: var(--color-texto-suave); font-size: var(--texto-s); }
  .ficha { margin: var(--espacio-2) 0 0; display: flex; flex-direction: column; border-top: var(--linea-fina) solid var(--color-linea); }
  .ficha div { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: var(--espacio-3); padding-block: var(--espacio-2); border-bottom: var(--linea-fina) solid var(--color-linea); font-size: var(--texto-s); }
  .ficha dt { font-family: var(--fuente-mono); font-size: var(--texto-xs); color: var(--color-texto-suave); }
  .ficha dd { margin: 0; }
  .acciones { display: flex; flex-wrap: wrap; gap: var(--espacio-2); padding-top: var(--espacio-2); }
  .acciones .pildora { padding-inline: 1.25rem; }
  .aviso-legal { margin: 0; font-size: 0.6875rem; line-height: 1.5; color: var(--color-texto-suave); max-width: 34rem; }
</style>
