---
import { idiomaDe, enlace, t } from '../i18n'
// Caso 02 · Realtime Chat: la misma conversación del hero, ahora guiada por el scroll dentro de "Selected work".
// La animación es la del hero (src/scripts/chatHero.ts); "Try it live" abre la demo (/chat-live.html).
import HeroApp from './HeroApp.astro'
import { RESPUESTA } from '../scripts/chatHero'

const pasos = t(idiomaDe(Astro.url), {
  en: ["A guest is typing", "Messages arrive instantly", "Presence: who is writing, who is online", "Type · send · delivered to everyone"],
  de: ["Ein Gast schreibt", "Nachrichten kommen sofort an", "Präsenz: wer schreibt, wer online ist", "Tippen · senden · bei allen angekommen"],
  es: ["Un invitado está escribiendo", "Los mensajes llegan al instante", "Presencia: quién escribe, quién está conectado", "Escribir · enviar · entregado a todos"],
})
import CasoTexto from './CasoTexto.astro'
// El texto largo del caso (se usa junto a la animación y, en el móvil, debajo de ella)
const idioma = idiomaDe(Astro.url)
// Kicker, título y nombre accesible del caso
const cab = t(idioma, {"en": {"kicker": "Case 02 · Design + development · ", "titulo": "Realtime Chat", "sub": "A conversation, built in real time.", "aria": "Case 02 · Realtime Chat", "live": "● Live"}, "de": {"kicker": "Case 02 · Design + Entwicklung · ", "titulo": "Echtzeit-Chat", "sub": "Ein Gespräch, in Echtzeit gebaut.", "aria": "Case 02 · Echtzeit-Chat", "live": "● Live"}, "es": {"kicker": "Caso 02 · Diseño + desarrollo · ", "titulo": "Chat en tiempo real", "sub": "Una conversación, construida en tiempo real.", "aria": "Caso 02 · Chat en tiempo real", "live": "● En vivo"}})
const texto = t(idioma, {
  en: {
    entradilla: "A focused web application exploring what happens behind a seemingly simple interaction: two people, one conversation, instantly synchronized.",
    suave: "I designed and built the complete experience — interface, real-time messaging, presence, database rules and deployment — turning a familiar interaction into a working end-to-end product.",
    ficha: [["Role", "Product Design · Front-end · Back-end"], ["Stack", "React · Supabase Realtime · Postgres RLS"], ["Scope", "Messaging · Presence · Data · Deployment"]],
    acciones: [{ texto: "Read the case study →", href: enlace(idioma, "/app-chat.html"), llena: true }, { texto: "Try it live ↗", href: "/chat-live.html" }, { texto: "Next project ↓", href: "#caso-otramesa", siguiente: true }],
  },
  de: {
    entradilla: "Eine fokussierte Webanwendung, die zeigt, was hinter einer scheinbar einfachen Interaktion passiert: zwei Menschen, ein Gespräch, sofort synchronisiert.",
    suave: "Ich habe das gesamte Erlebnis gestaltet und entwickelt — Interface, Echtzeit-Nachrichten, Präsenz, Datenbankregeln und Deployment — und so aus einer vertrauten Interaktion ein funktionierendes End-to-End-Produkt gemacht.",
    ficha: [["Rolle", "Produktdesign · Front-end · Back-end"], ["Stack", "React · Supabase Realtime · Postgres RLS"], ["Umfang", "Messaging · Präsenz · Daten · Deployment"]],
    acciones: [{ texto: "Case Study →", href: enlace(idioma, "/app-chat.html"), llena: true }, { texto: "Live testen ↗", href: "/chat-live.html" }, { texto: "Nächstes Projekt ↓", href: "#caso-otramesa", siguiente: true }],
  },
  es: {
    entradilla: "Una aplicación web centrada en lo que ocurre detrás de una interacción aparentemente simple: dos personas, una conversación, sincronizadas al instante.",
    suave: "Diseñé y desarrollé la experiencia completa — interfaz, mensajería en tiempo real, presencia, reglas de la base de datos y despliegue — convirtiendo una interacción conocida en un producto completo que funciona de principio a fin.",
    ficha: [["Rol", "Diseño de producto · Front-end · Back-end"], ["Stack", "React · Supabase Realtime · Postgres RLS"], ["Alcance", "Mensajería · Presencia · Datos · Despliegue"]],
    acciones: [{ texto: "Leer el caso →", href: enlace(idioma, "/app-chat.html"), llena: true }, { texto: "Probar en vivo ↗", href: "/chat-live.html" }, { texto: "Siguiente ↓", href: "#caso-otramesa", siguiente: true }],
  },
})
---

<section class="chat-caso" id="caso-chat" data-chat-caso aria-label={cab.aria}>
  <div class="escena contenedor">
    <div class="texto">
      <p class="etiqueta">{cab.kicker}<span class="en-vivo">{cab.live}</span></p>
      <h3 class="titulo">{cab.titulo}<span class="titulo-2">{cab.sub}</span></h3>
      <CasoTexto {...texto} enEscena />
    </div>

    <div class="dispositivo">
      <div class="movil"><HeroApp /></div>
    </div>

    <div class="leyenda">
      <div class="leyenda-pasos">
        {pasos.map((p, i) => <p class="etiqueta paso" data-paso={i}><span>{String(i + 1).padStart(2, '0')}</span> {p}</p>)}
      </div>
      <div class="progreso"><span data-progreso></span></div>
    </div>
  </div>
</section>
<!-- En móvil la escena fija no tiene sitio para los botones: van aquí, justo debajo de la animación -->
<div class="contenedor detalle-movil"><CasoTexto {...texto} /></div>

<script define:vars={{ RESPUESTA }}>
  // Sin animación (reducir movimiento) se ve la conversación completa, con la última respuesta escrita
  document.querySelector('[data-chat-caso] [data-final-texto]').textContent = RESPUESTA
</script>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { crearLineaChat } from '../scripts/chatHero'
  gsap.registerPlugin(ScrollTrigger)

  const caso = document.querySelector<HTMLElement>('[data-chat-caso]')!
  const pasos = caso.querySelectorAll('[data-paso]')

  const mm = gsap.matchMedia()
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    caso.classList.add('chat-caso--animado')
    gsap.set(pasos, { autoAlpha: 0, y: 10 }); gsap.set(pasos[0], { autoAlpha: 1, y: 0 })

    const tl = gsap.timeline({
      scrollTrigger: { trigger: caso, start: 'top top', end: 'bottom bottom', scrub: 0.6 },
    })
    // La misma conversación que en el hero (dura ~5,1 "segundos" de línea de tiempo)
    tl.add(crearLineaChat(caso.querySelector<HTMLElement>('[data-chat]')!), 0.2)
    const paso = (i: number, t: number) => {
      tl.to(pasos[i - 1], { autoAlpha: 0, y: -10, duration: 0.2 }, t)
        .to(pasos[i], { autoAlpha: 1, y: 0, duration: 0.2 }, t + 0.15)
    }
    paso(1, 1.2)
    paso(2, 1.8)
    paso(3, 2.9)
    tl.fromTo(caso.querySelector('[data-progreso]'), { scaleX: 0 }, { scaleX: 1, duration: 5.6, ease: 'none' }, 0)
    tl.to({}, { duration: 0.3 }) // un respiro al final, con el mensaje ya enviado
    return () => caso.classList.remove('chat-caso--animado')
  })
</script>

<style>
  .escena {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    grid-template-areas: 'texto dispositivo' 'leyenda dispositivo';
    align-items: center;
    column-gap: var(--espacio-7);
    padding-block: var(--espacio-7);
  }
  .chat-caso--animado { height: calc(340svh - var(--alto-cabecera)); }
  .chat-caso--animado .escena {
    position: sticky; top: calc(var(--alto-cabecera) + var(--alto-barra-trabajos));
    height: calc(100svh - var(--alto-cabecera) - var(--alto-barra-trabajos));
    align-content: center; padding-block: var(--espacio-5);
  }

  .texto { grid-area: texto; display: flex; flex-direction: column; gap: var(--espacio-4); }
  .en-vivo { color: var(--color-acento); }
  .titulo-2 { display: block; color: var(--color-texto-suave); }
  .titulo { font-size: var(--titulo-2); font-weight: var(--peso-fino); letter-spacing: var(--tracking-titulo); line-height: 1.02; }

  /* ---------- El móvil con el chat (el mismo del hero) ---------- */
  .dispositivo { grid-area: dispositivo; display: flex; justify-content: center; align-items: center; height: 100%; min-height: 0; }
  .movil { height: min(100%, 72svh); aspect-ratio: 0.6; max-width: 100%; }

  /* ---------- Leyenda ---------- */
  .leyenda { grid-area: leyenda; align-self: end; display: flex; flex-direction: column; gap: var(--espacio-3); padding-top: var(--espacio-5); }
  .leyenda-pasos { display: grid; }
  .paso { grid-area: 1 / 1; margin: 0; }
  .paso span { color: var(--color-acento); }
  .chat-caso:not(.chat-caso--animado) .paso:not(:first-child) { display: none; }
  .progreso { height: 2px; border-radius: 2px; background: var(--color-linea); overflow: hidden; max-width: 22rem; }
  .progreso span { display: block; height: 100%; background: var(--color-acento); transform-origin: left; transform: scaleX(0); }

  @media (max-width: 900px) {
    .escena { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'texto' 'dispositivo' 'leyenda'; row-gap: var(--espacio-5); }
    .chat-caso--animado .escena { align-content: start; overflow: hidden; }
    .dispositivo { height: 44svh; }
    .movil { height: 100%; }
  }
</style>
