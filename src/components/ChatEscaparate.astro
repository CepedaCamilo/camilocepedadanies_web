---
// Caso 02 · Realtime Chat: la misma conversación del hero, ahora guiada por el scroll dentro de "Selected work".
// La animación es la del hero (src/scripts/chatHero.ts); "Try it live" abre la demo (/chat-live.html).
import HeroApp from './HeroApp.astro'
import { RESPUESTA } from '../scripts/chatHero'

const pasos = [
  'A guest is typing',
  'Messages arrive instantly',
  'Presence: who is writing, who is online',
  'Type · send · delivered to everyone',
]
---

<section class="chat-caso" id="caso-chat" data-chat-caso aria-label="Case 02 · Realtime Chat">
  <div class="escena contenedor">
    <div class="texto">
      <p class="etiqueta">Case 02 · Design + development · <span class="en-vivo">● Live</span></p>
      <h3 class="titulo">Realtime Chat<span class="titulo-2">A conversation, built in real time.</span></h3>
      <p class="entradilla">
        A focused web application exploring what happens behind a seemingly simple interaction: two people, one
        conversation, instantly synchronized.
      </p>
      <p class="texto-suave">
        I designed and built the complete experience — interface, real-time messaging, presence, database rules and
        deployment — turning a familiar interaction into a working end-to-end product.
      </p>
      <dl class="ficha">
        <div><dt>Role</dt><dd>Product Design · Front-end · Back-end</dd></div>
        <div><dt>Stack</dt><dd>React · Supabase Realtime · Postgres RLS</dd></div>
        <div><dt>Scope</dt><dd>Messaging · Presence · Data · Deployment</dd></div>
      </dl>
      <div class="acciones">
        <a class="pildora pildora--llena" href="/app-chat.html">Read the case study →</a>
        <a class="pildora" href="/chat-live.html">Try it live ↗</a>
        <a class="pildora" href="#caso-archivos" data-siguiente>Next project ↓</a>
      </div>
    </div>

    <div class="dispositivo">
      <div class="movil"><HeroApp /></div>
    </div>

    <div class="leyenda">
      <div class="leyenda-pasos">
        {pasos.map((p, i) => <p class="etiqueta paso" data-paso={i}><span>{String(i + 1).padStart(2, '0')}</span> {p}</p>)}
      </div>
      <div class="progreso"><span data-progreso></span></div>
    </div>
  </div>
</section>
<!-- En móvil la escena fija no tiene sitio para los botones: van aquí, justo debajo de la animación -->
<div class="contenedor acciones-movil">
  <a class="pildora pildora--llena" href="/app-chat.html">Read the case study →</a>
  <a class="pildora" href="/chat-live.html">Try it live ↗</a>
  <a class="pildora" href="#caso-archivos" data-siguiente>Next project ↓</a>
</div>

<script define:vars={{ RESPUESTA }}>
  // Sin animación (reducir movimiento) se ve la conversación completa, con la última respuesta escrita
  document.querySelector('[data-chat-caso] [data-final-texto]').textContent = RESPUESTA
</script>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { crearLineaChat } from '../scripts/chatHero'
  gsap.registerPlugin(ScrollTrigger)

  const caso = document.querySelector<HTMLElement>('[data-chat-caso]')!
  const pasos = caso.querySelectorAll('[data-paso]')

  const mm = gsap.matchMedia()
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    caso.classList.add('chat-caso--animado')
    gsap.set(pasos, { autoAlpha: 0, y: 10 }); gsap.set(pasos[0], { autoAlpha: 1, y: 0 })

    const tl = gsap.timeline({
      scrollTrigger: { trigger: caso, start: 'top top', end: 'bottom bottom', scrub: 0.6 },
    })
    // La misma conversación que en el hero (dura ~5,1 "segundos" de línea de tiempo)
    tl.add(crearLineaChat(caso.querySelector<HTMLElement>('[data-chat]')!), 0.2)
    const paso = (i: number, t: number) => {
      tl.to(pasos[i - 1], { autoAlpha: 0, y: -10, duration: 0.2 }, t)
        .to(pasos[i], { autoAlpha: 1, y: 0, duration: 0.2 }, t + 0.15)
    }
    paso(1, 1.2)
    paso(2, 1.8)
    paso(3, 2.9)
    tl.fromTo(caso.querySelector('[data-progreso]'), { scaleX: 0 }, { scaleX: 1, duration: 5.6, ease: 'none' }, 0)
    tl.to({}, { duration: 0.3 }) // un respiro al final, con el mensaje ya enviado
    return () => caso.classList.remove('chat-caso--animado')
  })
</script>

<style>
  .escena {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    grid-template-areas: 'texto dispositivo' 'leyenda dispositivo';
    align-items: center;
    column-gap: var(--espacio-7);
    padding-block: var(--espacio-7);
  }
  .chat-caso--animado { height: calc(340svh - var(--alto-cabecera)); }
  .chat-caso--animado .escena {
    position: sticky; top: calc(var(--alto-cabecera) + var(--alto-barra-trabajos));
    height: calc(100svh - var(--alto-cabecera) - var(--alto-barra-trabajos));
    align-content: center; padding-block: var(--espacio-5);
  }

  .texto { grid-area: texto; display: flex; flex-direction: column; gap: var(--espacio-4); }
  .en-vivo { color: var(--color-acento); }
  .titulo-2 { display: block; color: var(--color-texto-suave); }
  .titulo { font-size: var(--titulo-2); font-weight: var(--peso-fino); letter-spacing: var(--tracking-titulo); line-height: 1.02; }
  .texto-suave { margin: 0; color: var(--color-texto-suave); font-size: var(--texto-s); }
  .ficha { margin: var(--espacio-2) 0 0; display: flex; flex-direction: column; border-top: var(--linea-fina) solid var(--color-linea); }
  .ficha div { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr); gap: var(--espacio-3); padding-block: var(--espacio-2); border-bottom: var(--linea-fina) solid var(--color-linea); font-size: var(--texto-s); }
  .ficha dt { font-family: var(--fuente-mono); font-size: var(--texto-xs); color: var(--color-texto-suave); }
  .ficha dd { margin: 0; }
  .acciones { display: flex; flex-wrap: wrap; gap: var(--espacio-2); padding-top: var(--espacio-2); }
  .acciones .pildora, .acciones-movil .pildora { padding-inline: 1.25rem; }
  .acciones-movil { display: none; flex-wrap: wrap; gap: var(--espacio-2); padding-block: var(--espacio-5) var(--espacio-2); }

  /* ---------- El móvil con el chat (el mismo del hero) ---------- */
  .dispositivo { grid-area: dispositivo; display: flex; justify-content: center; align-items: center; height: 100%; min-height: 0; }
  .movil { height: min(100%, 72svh); aspect-ratio: 0.6; max-width: 100%; }

  /* ---------- Leyenda ---------- */
  .leyenda { grid-area: leyenda; align-self: end; display: flex; flex-direction: column; gap: var(--espacio-3); padding-top: var(--espacio-5); }
  .leyenda-pasos { display: grid; }
  .paso { grid-area: 1 / 1; margin: 0; }
  .paso span { color: var(--color-acento); }
  .chat-caso:not(.chat-caso--animado) .paso:not(:first-child) { display: none; }
  .progreso { height: 2px; border-radius: 2px; background: var(--color-linea); overflow: hidden; max-width: 22rem; }
  .progreso span { display: block; height: 100%; background: var(--color-acento); transform-origin: left; transform: scaleX(0); }

  @media (max-width: 900px) {
    .escena { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'texto' 'dispositivo' 'leyenda'; row-gap: var(--espacio-5); }
    .chat-caso--animado .escena { align-content: start; overflow: hidden; }
    .chat-caso--animado .texto .entradilla, .chat-caso--animado .texto-suave, .chat-caso--animado .ficha,
    .chat-caso--animado .acciones { display: none; }
    .chat-caso--animado + .acciones-movil { display: flex; }
    .dispositivo { height: 42svh; }
    .movil { height: 100%; }
  }
</style>
