---
// "THE BRIDGE": vídeo en bucle justo debajo del hero.
// Siempre a pantalla completa. Al llegar, la página entera pasa a oscuro ("modo cine", como apple.com)
// y el título aparece encima con el scroll. Al salir, todo vuelve a su color.
import { idiomaDe, t } from '../i18n'
const textos = t(idiomaDe(Astro.url), {
  en: { aria: 'The Bridge — AI storytelling film', kicker: 'AI direction · Storytelling', texto: 'AI-supported cinematic production — narrative planning, scene continuity and human editorial control.' },
  de: { aria: 'The Bridge — ein mit KI erzählter Film', kicker: 'KI-Regie · Storytelling', texto: 'KI-gestützte filmische Produktion — narrative Planung, Szenenkontinuität und menschliche redaktionelle Kontrolle.' },
  es: { aria: 'The Bridge — película narrada con IA', kicker: 'Dirección con IA · Storytelling', texto: 'Producción cinematográfica apoyada en IA — planificación narrativa, continuidad de escena y control editorial humano.' },
})
---

<section class="cine" data-cine aria-label={textos.aria}>
  <div class="escena">
    <div class="marco" data-marco>
      <video data-video muted loop playsinline preload="metadata" poster="/videos/ai-storytelling-poster.jpg">
        <source src="/videos/the-bridge.mp4" type="video/mp4" />
      </video>
      <div class="velo" data-velo></div>
    </div>
    <div class="texto contenedor" data-texto>
      <p class="etiqueta">{textos.kicker}</p>
      <h2>The Bridge.</h2>
      <p class="entradilla">{textos.texto}</p>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  const cine = document.querySelector<HTMLElement>('[data-cine]')!
  const video = cine.querySelector<HTMLVideoElement>('[data-video]')!
  const raiz = document.documentElement

  // El vídeo solo se reproduce mientras la sección está en pantalla (ahorra batería y datos)
  ScrollTrigger.create({
    trigger: cine,
    start: 'top bottom',
    end: 'bottom top',
    onToggle: (st) => (st.isActive ? video.play().catch(() => {}) : video.pause()),
  })

  // Modo cine: la página pasa a oscuro mientras la sección ocupa la pantalla
  ScrollTrigger.create({
    trigger: cine,
    start: 'top 55%',
    end: 'bottom 45%',
    onToggle: (st) => raiz.classList.toggle('cine', st.isActive),
  })

  const mm = gsap.matchMedia()
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    cine.classList.add('cine--animado')
    const tl = gsap.timeline({
      defaults: { ease: 'none' },
      scrollTrigger: { trigger: cine, start: 'top top', end: 'bottom bottom', scrub: 0.6 },
    })
    // 1. Primero solo el vídeo, limpio. 2. Luego aparece el título encima. 3. Pausa para verlo
    tl.to({}, { duration: 0.5 })
      .fromTo(cine.querySelector('[data-velo]'), { opacity: 0 }, { opacity: 1, duration: 0.4 }, 0.5)
      .fromTo(cine.querySelector('[data-texto]'), { autoAlpha: 0, y: 40 }, { autoAlpha: 1, y: 0, duration: 0.4, ease: 'power2.out' }, 0.6)
      .to({}, { duration: 0.6 })
    return () => cine.classList.remove('cine--animado')
  })
</script>

<style>
  /* Sin animación: el vídeo a todo el ancho con el texto encima */
  .escena { position: relative; height: calc(100svh - var(--alto-cabecera)); overflow: hidden; }
  /* Con animación: 2 pantallas de recorrido con la escena fija */
  .cine--animado { height: 200svh; }
  .cine--animado .escena { position: sticky; top: var(--alto-cabecera); }
  /* en el móvil, a pantalla completa (el header aparece encima al subir y se esconde al bajar) */
  @media (max-width: 900px) {
    .cine--animado .escena { top: 0; height: 100svh; height: 100dvh; }
  }

  .marco { position: absolute; inset: 0; }
  video { width: 100%; height: 100%; object-fit: cover; display: block; background: #000; }
  .velo { position: absolute; inset: 0; background: rgb(0 0 0 / 0.38); }

  .texto {
    position: absolute; left: 0; right: 0; bottom: var(--espacio-7);
    display: flex; flex-direction: column; align-items: flex-start; gap: var(--espacio-4);
    color: #fff;
  }
  .texto .etiqueta, .texto .entradilla { color: rgb(255 255 255 / 0.78); }
  h2 { font-size: var(--titulo-1); }
  .texto .pildora { border-color: #fff; color: #fff; }
  .texto .pildora:hover { background: #fff; color: #111; }
</style>
