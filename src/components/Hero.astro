---
// Hero con transformación al hacer scroll:
// 01 foto → 02 balón → 03 app.
// Sin JavaScript o con "reducir movimiento" se queda quieto en la foto.
import { Image } from 'astro:assets'
import HeroApp from './HeroApp.astro'
import { sitio } from '../sitio'
import retrato from '../assets/marca/retrato.png'

// Los textos que acompañan a cada paso. Para añadir o cambiar un paso, empieza aquí.
const pasos = [
  { num: '01', texto: `Designer & builder · ${sitio.ciudad}` },
  { num: '02', texto: 'Football design · Trade Con · 2025' },
  { num: '03', texto: 'Web app · designed, coded & hosted by me' },
]
---

<section class="hero" data-hero>
  <div class="escena contenedor">
    <div class="texto">
      <p class="etiqueta">~/camilo · {sitio.ciudad}</p>
      <h1>Designing brands, products and the software behind them.</h1>
      <p class="entradilla">
        8+ years of brand, product and campaign design — and now my own web apps, from the interface to
        the server.
      </p>
      <div class="acciones">
        <a class="pildora pildora--llena" href="#work">See design work</a>
        <a class="pildora" href="#building">See software</a>
      </div>
    </div>

    <div class="escenario">
      <div class="flotar">
        <div class="capa capa--foto" data-capa="foto">
          <Image src={retrato} alt="Portrait of Camilo Cepeda Danies" widths={[360, 600]} sizes="(max-width: 900px) 60vw, 34rem" loading="eager" fetchpriority="high" />
        </div>
        <div class="capa capa--balon" data-capa="balon">
          <canvas data-balon aria-label="3D football I designed — drag to spin" role="img"></canvas>
        </div>
        <div class="capa capa--app" data-capa="app">
          <HeroApp />
        </div>
      </div>

      <div class="leyenda" aria-live="off">
        <div class="leyenda-textos">
          {pasos.map((p, i) => (
            <p class="etiqueta paso" data-paso={i}><span>{p.num}</span> {p.texto}</p>
          ))}
        </div>
        <div class="progreso"><span data-progreso></span></div>
      </div>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { iniciarBalon } from '../scripts/balon3d'

  gsap.registerPlugin(ScrollTrigger)
  const hero = document.querySelector<HTMLElement>('[data-hero]')!
  const capa = (n: string) => hero.querySelector(`[data-capa="${n}"]`)
  const pasos = hero.querySelectorAll('[data-paso]')

  const mm = gsap.matchMedia()
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    hero.classList.add('hero--animado')
    const balon3d = iniciarBalon(hero.querySelector<HTMLCanvasElement>('[data-balon]')!)

    // Posición inicial de cada objeto
    gsap.set(capa('balon'), { autoAlpha: 0, scale: 0.4, rotate: -140 })
    gsap.set(capa('app'), { autoAlpha: 0, yPercent: 40, scale: 0.85, rotate: 4 })
    gsap.set(pasos, { autoAlpha: 0, y: 12 })
    gsap.set(pasos[0], { autoAlpha: 1, y: 0 })

    const cambiarLeyenda = (de: number, a: number, t: number) => {
      tl.to(pasos[de], { autoAlpha: 0, y: -12, duration: 0.3 }, t)
      tl.to(pasos[a], { autoAlpha: 1, y: 0, duration: 0.3 }, t + 0.25)
    }

    // La línea de tiempo va atada al scroll (scrub): avanza y retrocede con la rueda
    const tl = gsap.timeline({
      defaults: { ease: 'power2.inOut', duration: 1 },
      scrollTrigger: {
        trigger: hero, start: 'top top', end: 'bottom bottom', scrub: 0.8,
        onUpdate: (st) => balon3d?.setScroll(st.progress),
      },
    })

    // 01 → 02: la foto se aleja y entra el balón girando
    tl.to(capa('foto'), { autoAlpha: 0, scale: 0.7, rotate: -8 }, 0)
      .to(capa('balon'), { autoAlpha: 1, scale: 1, rotate: 0, duration: 1.2 }, 0.15)
    cambiarLeyenda(0, 1, 0.4)

    // 02 → 03: el balón sale girando y aparece la app
    tl.to(capa('balon'), { autoAlpha: 0, scale: 0.5, rotate: 220, yPercent: -30 }, 1.8)
      .to(capa('app'), { autoAlpha: 1, yPercent: 0, scale: 1, rotate: 0 }, 1.95)
    cambiarLeyenda(1, 2, 2.1)

    // Pausa al final para ver la app, y barra de progreso durante todo el recorrido
    tl.to({}, { duration: 0.6 }, 2.95)
    tl.fromTo(hero.querySelector('[data-progreso]'), { scaleX: 0 }, { scaleX: 1, ease: 'none', duration: tl.duration() }, 0)

    return () => hero.classList.remove('hero--animado')
  })
</script>

<style>
  /* Sin animación: una sección normal con la foto */
  .hero { position: relative; }
  .escena {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: var(--espacio-7);
    padding-block: var(--espacio-7) var(--espacio-8);
  }
  /* Con animación: el hero mide 3 pantallas y la escena se queda fija mientras tanto */
  .hero--animado { height: 300svh; }
  .hero--animado .escena { position: sticky; top: 0; height: 100svh; padding-block: var(--espacio-6); }

  .texto { display: flex; flex-direction: column; gap: var(--espacio-5); }
  h1 { font-size: clamp(2.5rem, 1.5rem + 3.6vw, 4.25rem); text-wrap: balance; }
  .acciones { display: flex; flex-wrap: wrap; gap: var(--espacio-3); padding-top: var(--espacio-2); }

  .escenario { display: flex; flex-direction: column; align-items: center; gap: var(--espacio-5); }
  .flotar {
    position: relative;
    width: min(100%, 34rem, 58svh);
    aspect-ratio: 1;
    animation: flotar 7s ease-in-out infinite;
  }
  @keyframes flotar { 50% { transform: translateY(-10px); } }

  .capa { position: absolute; inset: 0; display: grid; place-items: center; will-change: transform, opacity; }
  .capa :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .capa--foto :global(img) { border-radius: 50%; object-fit: cover; }
  .capa--balon canvas { width: 100%; height: 100%; display: block; cursor: grab; touch-action: pan-y; }
  .capa--balon canvas:active { cursor: grabbing; }
  .capa--app { inset: 0 22%; }

  /* Sin animación, solo se ve la foto */
  .hero:not(.hero--animado) .capa:not(.capa--foto) { display: none; }

  .leyenda { width: min(100%, 26rem); display: flex; flex-direction: column; gap: var(--espacio-3); }
  .leyenda-textos { display: grid; }
  .paso { grid-area: 1 / 1; margin: 0; text-align: center; }
  .paso span { color: var(--color-acento); }
  .hero:not(.hero--animado) .paso:not(:first-child) { display: none; }
  .progreso { height: 2px; border-radius: 2px; background: var(--color-linea); overflow: hidden; }
  .progreso span { display: block; height: 100%; background: var(--color-acento); transform-origin: left; transform: scaleX(0); }
  .hero:not(.hero--animado) .progreso { display: none; }

  @media (prefers-reduced-motion: reduce) { .flotar { animation: none; } }

  @media (max-width: 900px) {
    .escena { grid-template-columns: minmax(0, 1fr); gap: var(--espacio-5); align-content: center; }
    .escenario { order: -1; }
    .flotar { width: min(78vw, 40svh); }
    .hero--animado .texto .entradilla, .hero--animado .acciones { display: none; }
    .hero--animado h1 { font-size: clamp(2rem, 1.4rem + 3vw, 2.75rem); }
  }
</style>
