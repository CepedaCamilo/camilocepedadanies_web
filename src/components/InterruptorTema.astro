---
// Interruptor Light / Dark con iconos (sol / luna). Recuerda la elección en este navegador (localStorage).
// Ojo: sus botones se buscan por [data-tema] (no por la clase), para no confundirlos con otros interruptores
// de la página (p. ej. Software | Design, que también usa la clase .interruptor).
---

<div class="interruptor-tema" role="group" aria-label="Color theme" data-interruptor-tema>
  <button type="button" data-tema="light" aria-pressed="false" aria-label="Light mode" title="Light">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="12" cy="12" r="4.2" />
      <path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6" />
    </svg>
  </button>
  <button type="button" data-tema="dark" aria-pressed="false" aria-label="Dark mode" title="Dark">
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20.2 14.6A8.3 8.3 0 0 1 9.4 3.8a8.3 8.3 0 1 0 10.8 10.8z" />
    </svg>
  </button>
</div>

<script>
  const raiz = document.documentElement
  const botones = document.querySelectorAll<HTMLButtonElement>('[data-interruptor-tema] [data-tema]')
  const sistemaOscuro = window.matchMedia('(prefers-color-scheme: dark)')

  function temaActual() {
    return raiz.dataset.theme ?? (sistemaOscuro.matches ? 'dark' : 'light')
  }
  function marcar() {
    const actual = temaActual()
    botones.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tema === actual)))
  }

  botones.forEach((boton) =>
    boton.addEventListener('click', () => {
      const tema = boton.dataset.tema
      if (tema !== 'light' && tema !== 'dark') return
      // El cambio de tema es instantáneo: sin el fundido de 0,7 s (que es para el "modo cine"), el fondo
      // pasaba por grises intermedios y a veces parecía más claro. Así siempre cae en el mismo negro.
      raiz.classList.add('cambiando-tema')
      raiz.dataset.theme = tema
      requestAnimationFrame(() => requestAnimationFrame(() => raiz.classList.remove('cambiando-tema')))
      try { localStorage.setItem('tema', tema) } catch {}
      marcar()
    })
  )
  sistemaOscuro.addEventListener('change', marcar)
  marcar()
</script>

<style>
  .interruptor-tema {
    display: flex;
    padding: 3px;
    border-radius: var(--radio-pildora);
    background: var(--color-superficie);
    border: var(--linea-fina) solid var(--color-linea);
  }
  button {
    display: grid; place-items: center;
    width: 34px; height: 34px; padding: 0;
    border: none;
    border-radius: var(--radio-pildora);
    background: transparent;
    color: var(--color-texto-suave);
    cursor: pointer;
    transition: background-color 0.2s, color 0.2s;
  }
  button:hover { color: var(--color-texto); }
  svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  button[aria-pressed='true'] { background: var(--color-invertido); color: var(--color-sobre-invertido); }
  /* en el móvil, más compacto: cabe en la misma fila que el logo */
  @media (max-width: 720px) { button { width: 30px; height: 30px; } svg { width: 15px; height: 15px; } }
  @media (max-width: 380px) { button { width: 28px; height: 28px; } }
</style>
