---
import { idiomaDe, enlace, t } from '../i18n'
// Caso 03 · Otra Mesa: salvar una hamburguesa, guiado por el scroll (pariente de Yaku, pero no igual).
// A la derecha, el móvil con la app dibujada en HTML (siempre en INGLÉS, modo claro): tres hamburguesas → abrir una →
// "Reserve" → código + QR ("Show this at the restaurant"). A la izquierda, un PORTÁTIL con el back office
// (modo oscuro) donde la reserva nueva entra en la tabla en ese mismo momento.
// Fotos: Unsplash (licencia libre) — margarita: Aurélien Lemasson-Théobald · pepperoni: Alan Hardman · queso y cherry: Ivan Torres.
import { Image } from 'astro:assets'
import QRCode from 'qrcode'
import CasoTexto from './CasoTexto.astro'
// Fotos: Unsplash (licencia libre) — doble: Eiliv Aceron · bunker: la de hamburguesas de la app · clásica: Ilya Mashkov
import burgerDoble from '../assets/otramesa/burger-doble.jpg'
import burgerBunker from '../assets/otramesa/burger-bunker.jpg'
import burgerClasica from '../assets/otramesa/burger-clasica.jpg'
import logo from '../assets/otramesa/logo-otramesa.svg'
import logoOscuro from '../assets/otramesa/logo-otramesa-oscuro.svg'

const CODIGO = 'K7MQ'
// Un QR de verdad (se puede escanear: dice OTRAMESA-K7MQ), generado al compilar la web
const qr = await QRCode.toString(`OTRAMESA-${CODIGO}`, { type: 'svg', margin: 0, color: { dark: '#1f2e26', light: '#ffffff' } })

const burgers = [
  { foto: burgerDoble, nombre: 'Smash Club', distancia: '120 m', antes: '$45.000', ahora: '$14.500', quedan: '2 left', pin: { x: 30, y: 58 } },
  { foto: burgerBunker, nombre: 'Bunker Burgers', distancia: '240 m', antes: '$42.000', ahora: '$12.500', quedan: '3 left', pin: { x: 64, y: 34 } },
  { foto: burgerClasica, nombre: 'Kilo Grill', distancia: '410 m', antes: '$36.000', ahora: '$11.500', quedan: '1 left', pin: { x: 78, y: 70 } },
]
const elegida = burgers[1]

const idioma = idiomaDe(Astro.url)
const pasos = t(idioma, {
  en: ['Find a burger to save nearby', 'Open the surprise', 'Reserve it — no payment needed', 'Get your QR — show it at the restaurant', 'The booking lands in the back office — live'],
  de: ['Einen Burger in der Nähe retten', 'Die Überraschung öffnen', 'Reservieren — ohne zu bezahlen', 'QR-Code erhalten — im Restaurant zeigen', 'Die Reservierung kommt im Back-Office an — live'],
  es: ['Buscar una hamburguesa que salvar cerca', 'Abrir la sorpresa', 'Reservarla — sin pagar', 'Recibir el QR — enseñarlo en el restaurante', 'La reserva entra en el back office — en vivo'],
})
const cab = t(idioma, {
  en: { kicker: 'Case 03 · Design + full-stack · ', titulo: 'Otra Mesa', sub: 'good food deserves another table.', aria: 'Case 03 · Otra Mesa', live: '● Live' },
  de: { kicker: 'Case 03 · Design + Full-Stack · ', titulo: 'Otra Mesa', sub: 'gutes Essen verdient einen zweiten Tisch.', aria: 'Case 03 · Otra Mesa', live: '● Live' },
  es: { kicker: 'Caso 03 · Diseño + full-stack · ', titulo: 'Otra Mesa', sub: 'lo bueno merece otra mesa.', aria: 'Caso 03 · Otra Mesa', live: '● En vivo' },
})
const texto = t(idioma, {
  en: {
    entradilla: 'Restaurants and wholesalers in Barranquilla offer the good food they didn’t sell as “house surprises”, at about a third of the price. People nearby reserve one, get a QR code and pick it up. My first fully own stack — designed, built and hosted by me.',
    suave: 'Less food wasted, more life for local restaurants. A working demo with made-up restaurants — real reservations, no money.',
    ficha: [['Role', 'Product design · Brand · Full-stack'], ['Stack', 'React · Node/Express · Postgres · MongoDB geo · Leaflet/OSM'], ['Scope', 'Customer app · Back office · API · Passwordless login']],
    acciones: [{ texto: 'Read the case study →', href: enlace(idioma, '/app-otramesa.html'), llena: true }, { texto: 'Try it live ↗', href: 'https://otramesa.danies.trade', externo: true }, { texto: 'Next project ↓', href: '#caso-archivos', siguiente: true }],
  },
  de: {
    entradilla: 'Restaurants und Großhändler in Barranquilla bieten gutes Essen, das sie nicht verkauft haben, als „Überraschung des Hauses“ an — für etwa ein Drittel des Preises. Menschen in der Nähe reservieren, erhalten einen QR-Code und holen ab. Mein erster komplett eigener Stack — von mir gestaltet, entwickelt und gehostet.',
    suave: 'Weniger Lebensmittelverschwendung, mehr Leben für lokale Restaurants. Eine funktionierende Demo mit erfundenen Restaurants — echte Reservierungen, ohne Geld.',
    ficha: [['Rolle', 'Produktdesign · Marke · Full-Stack'], ['Stack', 'React · Node/Express · Postgres · MongoDB Geo · Leaflet/OSM'], ['Umfang', 'Kunden-App · Back-Office · API · Login ohne Passwort']],
    acciones: [{ texto: 'Case Study →', href: enlace(idioma, '/app-otramesa.html'), llena: true }, { texto: 'Live testen ↗', href: 'https://otramesa.danies.trade', externo: true }, { texto: 'Nächstes Projekt ↓', href: '#caso-archivos', siguiente: true }],
  },
  es: {
    entradilla: 'Restaurantes y mayoristas de Barranquilla ofrecen la comida buena que no vendieron como “sorpresas de la casa”, a un tercio del precio. La gente cercana reserva una, recibe un código QR y la recoge. Mi primer stack completamente propio — diseñado, desarrollado y alojado por mí.',
    suave: 'Menos comida desperdiciada, más vida para los restaurantes del barrio. Una demo que funciona, con restaurantes inventados — reservas reales, sin dinero.',
    ficha: [['Rol', 'Diseño de producto · Marca · Full-stack'], ['Stack', 'React · Node/Express · Postgres · MongoDB geo · Leaflet/OSM'], ['Alcance', 'App de clientes · Back office · API · Login sin contraseña']],
    acciones: [{ texto: 'Leer el caso →', href: enlace(idioma, '/app-otramesa.html'), llena: true }, { texto: 'Probar en vivo ↗', href: 'https://otramesa.danies.trade', externo: true }, { texto: 'Siguiente ↓', href: '#caso-archivos', siguiente: true }],
  },
})
---

<section class="otramesa" id="caso-otramesa" data-otramesa aria-label={cab.aria}>
  <div class="escena contenedor">
    <div class="texto">
      <p class="etiqueta">{cab.kicker}<span class="en-vivo">{cab.live}</span></p>
      <h3 class="titulo">{cab.titulo}<span class="titulo-2">{cab.sub}</span></h3>
      <CasoTexto {...texto} enEscena />
    </div>

    <div class="dispositivos" aria-hidden="true">
      <!-- Portátil con el back office (modo oscuro, como el de verdad) -->
      <div class="portatil">
        <div class="portatil-pantalla">
          <div class="navegador"><span class="puntos"><i></i><i></i><i></i></span><span class="url">otramesa.danies.trade/gestion</span></div>
          <div class="bo">
            <div class="bo-cab">
              <Image src={logoOscuro} alt="" class="bo-logo" />
              <span class="bo-pildora">Back office</span>
              <span class="bo-tab">Restaurants</span><span class="bo-tab bo-tab--activa">Bookings</span>
              <span class="bo-quien">Camilo · admin</span>
            </div>
            <div class="bo-cuerpo">
              <div class="bo-entregar">
                <p class="bo-h">Hand over</p>
                <p class="bo-suave">Type the 4-letter code the customer shows.</p>
                <div class="bo-codigo"><span>K7MQ</span><b>✓ Hand over</b></div>
              </div>
              <div class="bo-reservas">
                <p class="bo-suave bo-cuenta">
                  <span class="cambia"><span data-viejo>2 bookings · 1 active</span><span data-nuevo>3 bookings · 2 active</span></span>
                  <span class="bo-live">● Live</span>
                </p>
                <div class="bo-tabla">
                  <div class="fila fila--cab"><span>Code</span><span>Status</span><span>Restaurant · surprise</span></div>
                  <div class="fila fila--nueva" data-fila-nueva><span class="cod">{CODIGO}</span><span><em class="est est--reservada">Reserved</em></span><span>{elegida.nombre}<small>Lunch surprise · {elegida.ahora} · 14:00–15:00</small></span></div>
                  <div class="fila"><span class="cod">Q9HW</span><span><em class="est est--reservada">Reserved</em></span><span>Crumb Bakery<small>Bakery surprise · $6.000 · 19:00–19:30</small></span></div>
                  <div class="fila"><span class="cod">M3TR</span><span><em class="est est--recogida">Picked up</em></span><span>Nuna Coffee<small>Sweet surprise · $5.500 · 17:00–18:00</small></span></div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="portatil-base"></div>
      </div>

      <!-- Móvil con la app (en inglés, modo claro) -->
      <div class="telefono">
        <div class="app">
          <!-- 1 · Hamburguesas cerca -->
          <div class="capa" data-pantalla="lista">
            <div class="app-cab"><Image src={logo} alt="" class="app-logo" /><span class="app-ubic">⌖ Alto Prado, Barranquilla</span></div>
            <div class="mapa">
              <span class="calle c1"></span><span class="calle c2"></span><span class="calle c3"></span><span class="rio"></span>
              <span class="yo" style="left:48%;top:52%"></span>
              {burgers.map((p, i) => <span class={`pin ${i === 1 ? 'pin--elegido' : ''}`} data-pin style={`left:${p.pin.x}%;top:${p.pin.y}%`}>{p.ahora}</span>)}
            </div>
            <p class="app-h">Burgers near you</p>
            <div class="lista">
              {burgers.map((p, i) => (
                <div class="tarjeta" data-tarjeta={i}>
                  <Image src={p.foto} alt="" widths={[160, 320]} sizes="90px" class="tarjeta-foto" />
                  <div class="tarjeta-texto">
                    <b>{p.nombre}</b>
                    <span>Lunch surprise · {p.distancia}</span>
                    <span>Today 14:00–15:00</span>
                    <span class="precio"><s>{p.antes}</s> <strong>{p.ahora}</strong></span>
                  </div>
                  <span class="quedan">{p.quedan}</span>
                </div>
              ))}
            </div>
            <div class="app-nav"><span class="activa">Discover</span><span>Explore</span><span>Favourites</span><span>Bookings</span></div>
          </div>

          <!-- 2 · La ficha de la hamburguesa elegida -->
          <div class="capa ficha" data-pantalla="ficha">
            <Image src={elegida.foto} alt="" widths={[390, 780]} sizes="300px" class="ficha-foto" />
            <div class="ficha-hoja">
              <p class="ficha-kicker">Lunch surprise · Burgers <span>{elegida.antes} <strong>{elegida.ahora}</strong></span></p>
              <p class="ficha-titulo">{elegida.nombre}</p>
              <p class="ficha-chips"><em>{elegida.quedan}</em> You save $29.500</p>
              <ul>
                <li>🛍 Today’s burgers, freshly made.</li>
                <li>🕑 Pick-up: Today 14:00–15:00</li>
                <li>⌖ {elegida.distancia} <u>Directions</u></li>
              </ul>
            </div>
            <div class="reservar" data-reservar><span class="r-1">Reserve · {elegida.ahora}</span><span class="r-2">Reserving…</span></div>
          </div>

          <!-- 3 · Reservada: código + QR -->
          <div class="capa confirmacion" data-pantalla="confirmacion">
            <span class="check">✓</span>
            <p class="conf-titulo">Reserved!</p>
            <p class="conf-sub">Lunch surprise · {elegida.nombre}</p>
            <div class="conf-tarjeta">
              <p class="conf-kicker">Your pick-up code</p>
              <p class="conf-codigo">{CODIGO}</p>
              <div class="qr" data-qr set:html={qr} />
              <p class="conf-mostrar">Show this at the restaurant.</p>
            </div>
            <p class="conf-linea">Today 14:00–15:00 · {elegida.ahora} · Pay at pick-up</p>
            <span class="conf-boton">See my bookings</span>
          </div>
          <span class="toque" data-toque></span>
        </div>
      </div>
    </div>

    <div class="leyenda">
      <div class="leyenda-pasos">
        {pasos.map((p, i) => <p class="etiqueta paso" data-paso={i}><span>{String(i + 1).padStart(2, '0')}</span> {p}</p>)}
      </div>
      <div class="progreso"><span data-progreso></span></div>
    </div>
  </div>
</section>
<!-- En el móvil, el texto completo del caso va aquí, justo debajo de la animación -->
<div class="contenedor detalle-movil"><CasoTexto {...texto} /></div>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  const om = document.querySelector<HTMLElement>('[data-otramesa]')!
  const capa = (id: string) => om.querySelector(`[data-pantalla="${id}"]`)
  const toque = om.querySelector('[data-toque]')
  const pasos = om.querySelectorAll('[data-paso]')
  const filaNueva = om.querySelector<HTMLElement>('[data-fila-nueva]')!

  const mm = gsap.matchMedia()
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    om.classList.add('otramesa--animado')
    gsap.set(om.querySelectorAll('[data-pantalla]'), { autoAlpha: 0 })
    gsap.set(capa('lista'), { autoAlpha: 1 })
    gsap.set(pasos, { autoAlpha: 0, y: 10 }); gsap.set(pasos[0], { autoAlpha: 1, y: 0 })
    gsap.set(om.querySelectorAll('[data-pin]'), { autoAlpha: 0, scale: 0.6 })
    gsap.set(om.querySelectorAll('[data-tarjeta]'), { autoAlpha: 0, y: 24 })
    gsap.set(filaNueva, { autoAlpha: 0, y: -14 })
    gsap.set(om.querySelector('[data-nuevo]'), { autoAlpha: 0 })
    gsap.set(om.querySelector('.r-2'), { autoAlpha: 0 })
    gsap.set(om.querySelector('[data-qr]'), { autoAlpha: 0, scale: 0.85 })
    gsap.set(toque, { autoAlpha: 0, scale: 0.4 })

    const tl = gsap.timeline({
      defaults: { ease: 'power2.inOut', duration: 0.5 },
      scrollTrigger: { trigger: om, start: 'top top', end: 'bottom bottom', scrub: 0.6 },
    })
    const paso = (i: number, t: number) => {
      tl.to(pasos[i - 1], { autoAlpha: 0, y: -10, duration: 0.2 }, t).to(pasos[i], { autoAlpha: 1, y: 0, duration: 0.2 }, t + 0.15)
    }
    const tocar = (x: number, y: number, t: number) => {
      tl.set(toque, { left: `${x}%`, top: `${y}%` }, t)
        .to(toque, { autoAlpha: 1, scale: 1, duration: 0.12, ease: 'power1.out' }, t)
        .to(toque, { autoAlpha: 0, scale: 1.6, duration: 0.25 }, t + 0.14)
    }

    // 01 · aparecen los precios en el mapa y las tres hamburguesas
    tl.to(om.querySelectorAll('[data-pin]'), { autoAlpha: 1, scale: 1, duration: 0.25, stagger: 0.1, ease: 'back.out(2)' }, 0.05)
      .to(om.querySelectorAll('[data-tarjeta]'), { autoAlpha: 1, y: 0, duration: 0.3, stagger: 0.12 }, 0.2)
      .to(om.querySelector('.pin--elegido'), { scale: 1.18, duration: 0.15, yoyo: true, repeat: 1 }, 0.8)
    // 02 · toque en la pepperoni → se abre su ficha desde abajo
    paso(1, 1.0); tocar(50, 66, 1.1)
    tl.set(capa('ficha'), { autoAlpha: 1, yPercent: 100 }, 1.25).to(capa('ficha'), { yPercent: 0, duration: 0.45 }, 1.25)
      .to(capa('lista'), { autoAlpha: 0, duration: 0.01 }, 1.7)
    // 03 · toque en "Reserve" → "Reserving…"
    paso(2, 2.0); tocar(50, 93, 2.1)
    tl.to(om.querySelector('.r-1'), { autoAlpha: 0, duration: 0.1 }, 2.22).to(om.querySelector('.r-2'), { autoAlpha: 1, duration: 0.1 }, 2.24)
      .to(om.querySelector('[data-reservar]'), { scale: 0.97, duration: 0.1, yoyo: true, repeat: 1 }, 2.22)
    // 04 · reservada: código y QR
    paso(3, 2.6)
    tl.to(capa('confirmacion'), { autoAlpha: 1, duration: 0.35 }, 2.6)
      .to(om.querySelector('[data-qr]'), { autoAlpha: 1, scale: 1, duration: 0.35, ease: 'back.out(1.6)' }, 2.8)
      .to(capa('ficha'), { autoAlpha: 0, duration: 0.01 }, 3.0)
    // 05 · en ese momento, la reserva entra en el back office
    paso(4, 3.3)
    tl.to(filaNueva, { autoAlpha: 1, y: 0, duration: 0.35, ease: 'back.out(1.6)' }, 3.35)
      .to(om.querySelector('[data-viejo]'), { autoAlpha: 0, duration: 0.15 }, 3.35)
      .to(om.querySelector('[data-nuevo]'), { autoAlpha: 1, duration: 0.15 }, 3.4)
      .fromTo(filaNueva, { boxShadow: 'inset 0 0 0 0 rgb(224 122 60 / 0)' }, { boxShadow: 'inset 0 0 0 2px rgb(224 122 60 / 1)', duration: 0.25, yoyo: true, repeat: 1 }, 3.7)
    tl.to({}, { duration: 0.7 })
    tl.fromTo(om.querySelector('[data-progreso]'), { scaleX: 0 }, { scaleX: 1, ease: 'none', duration: tl.duration() }, 0)

    return () => om.classList.remove('otramesa--animado')
  })
</script>

<style>
  .escena {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    grid-template-areas: 'texto dispositivos' 'leyenda dispositivos';
    align-items: center;
    column-gap: var(--espacio-7);
    padding-block: var(--espacio-7);
  }
  .otramesa--animado { height: calc(420svh - var(--alto-cabecera)); }
  .otramesa--animado .escena {
    position: sticky; top: calc(var(--alto-cabecera) + var(--alto-barra-trabajos));
    height: calc(100svh - var(--alto-cabecera) - var(--alto-barra-trabajos));
    align-content: center; padding-block: var(--espacio-5);
  }
  .texto { grid-area: texto; display: flex; flex-direction: column; gap: var(--espacio-4); }
  .en-vivo { color: var(--color-acento); }
  .titulo-2 { display: block; color: var(--color-texto-suave); }
  .titulo { font-size: var(--titulo-2); font-weight: var(--peso-fino); letter-spacing: var(--tracking-titulo); line-height: 1.02; }

  /* ---------- Dispositivos ---------- */
  .dispositivos { grid-area: dispositivos; position: relative; aspect-ratio: 1.15; width: 100%; max-height: 74svh; justify-self: center; }

  /* Portátil (izquierda) con el back office */
  .portatil { position: absolute; left: 0; top: 10%; width: 84%; }
  .portatil-pantalla {
    aspect-ratio: 16 / 10.4; padding: 1.4%; border-radius: 2.4% 2.4% 0 0 / 3.6% 3.6% 0 0; background: #0b0a09;
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.5), inset 0 0 0 1px rgb(255 255 255 / 0.08); display: flex; flex-direction: column;
  }
  .portatil-base { height: 0; padding-bottom: 3.2%; margin: 0 -4%; border-radius: 0 0 18% 18% / 0 0 100% 100%; background: linear-gradient(#cfcac2, #9d978e); }
  .navegador { display: flex; align-items: center; gap: 2.4cqw; padding: 1.2cqw 2cqw; background: #1c1a18; border-radius: 1cqw 1cqw 0 0; container-type: inline-size; }
  .navegador, .bo { container-type: inline-size; }
  .puntos { display: flex; gap: 0.8cqw; } .puntos i { width: 1.1cqw; aspect-ratio: 1; border-radius: 50%; background: #3a3530; }
  .url { flex: 1; padding: 0.5cqw 2cqw; border-radius: 99px; background: #121110; color: #a8a198; font-size: 1.5cqw; }
  .bo { flex: 1; overflow: hidden; background: #121110; color: #f2eee6; font-family: Poppins, var(--fuente-texto, system-ui), sans-serif; display: flex; flex-direction: column; }
  .bo-cab { display: flex; align-items: center; gap: 1.8cqw; padding: 1.8cqw 3cqw; border-bottom: 1px solid #2e2b27; font-size: 1.6cqw; }
  .bo-logo { height: 4.2cqw; width: auto; }
  .bo-pildora { padding: 0.3cqw 1.2cqw; border-radius: 99px; background: #2f6b4a; font-weight: 600; font-size: 1.3cqw; }
  .bo-tab { color: #a8a198; padding: 0.6cqw 1.4cqw; border-radius: 99px; }
  .bo-tab--activa { background: #262320; color: #f2eee6; }
  .bo-quien { margin-left: auto; color: #a8a198; }
  /* El móvil tapa el último cuarto del portátil: todo lo importante cabe en los primeros ~75 % */
  .bo-cuerpo { flex: 1; display: grid; grid-template-columns: 24% 50%; gap: 2.4cqw; padding: 2.6cqw 3cqw; }
  .bo-entregar { align-self: start; display: flex; flex-direction: column; gap: 1cqw; padding: 2cqw; border-radius: 2cqw; background: #1c1a18; }
  .bo-h { margin: 0; font-weight: 700; text-transform: uppercase; font-size: 2.1cqw; }
  .bo-suave { margin: 0; color: #a8a198; font-size: 1.35cqw; }
  .bo-codigo { display: flex; flex-direction: column; gap: 0.8cqw; }
  .bo-codigo span { padding: 0.9cqw 1.2cqw; border-radius: 1cqw; border: 1px solid #2e2b27; color: #6f6a64; letter-spacing: 0.4cqw; font-weight: 700; font-size: 1.9cqw; }
  .bo-codigo b { padding: 0.9cqw; border-radius: 99px; background: #bd6227; text-align: center; font-size: 1.4cqw; }
  .bo-reservas { display: flex; flex-direction: column; gap: 1.2cqw; min-width: 0; }
  .bo-cuenta { display: flex; gap: 2cqw; }
  .cambia { display: grid; } .cambia > span { grid-area: 1 / 1; }
  .bo-live { color: #9fd49f; }
  .bo-tabla { border: 1px solid #2e2b27; border-radius: 1.6cqw; overflow: hidden; font-size: 1.6cqw; }
  .fila { display: grid; grid-template-columns: 17% 25% 58%; padding: 1.2cqw 1.6cqw; border-bottom: 1px solid #2e2b27; align-items: center; white-space: nowrap; }
  .fila small { display: block; color: #a8a198; font-size: 1.25cqw; }
  .fila > span { overflow: hidden; text-overflow: ellipsis; }
  .fila--cab { background: #1c1a18; color: #a8a198; font-weight: 600; }
  .fila--nueva { background: #1f1b17; }
  .cod { font-weight: 700; letter-spacing: 0.25cqw; }
  .est { font-style: normal; padding: 0.3cqw 1.1cqw; border-radius: 99px; font-weight: 600; font-size: 1.3cqw; }
  .est--reservada { background: #2f6b4a; color: #fff; }
  .est--recogida { background: #bd6227; color: #fff; }

  /* Móvil (derecha) con la app — proporción 390×844 y todo medido en cqw (1cqw = 1 % del ancho de la pantalla) */
  .telefono {
