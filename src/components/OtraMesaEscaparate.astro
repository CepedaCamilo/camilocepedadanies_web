---
import { idiomaDe, enlace, t } from '../i18n'
// Caso 03 · Otra Mesa: salvar una hamburguesa, guiado por el scroll. Dibujado con el DISEÑO LIMPIO de la app (7 oct 2026):
// fondo blanco, textos de un color, letra Figtree, botones verdes y el terracota solo en detalles.
// A la derecha, el móvil con la app en HTML (siempre en INGLÉS): Sorpresas destacadas que se deslizan → abrir Bunker Burgers →
// "Reserve" → pagar con la tarjeta de prueba → código + QR. A la izquierda, un PORTÁTIL con el back office (Gestión, también blanco)
// donde la reserva nueva entra en la tabla en ese mismo momento.
import { Image } from 'astro:assets'
import QRCode from 'qrcode'
import '@fontsource-variable/figtree/wght.css'
import CasoTexto from './CasoTexto.astro'
// Fotos: Unsplash (licencia libre) — doble: Eiliv Aceron · bunker: la de hamburguesas de la app · clásica: Ilya Mashkov
// · pizza: Aurélien Lemasson-Théobald · panadería: Mae Mu (las dos, fotos de la app)
import burgerDoble from '../assets/otramesa/burger-doble.jpg'
import burgerBunker from '../assets/otramesa/burger-bunker.jpg'
import burgerClasica from '../assets/otramesa/burger-clasica.jpg'
import fotoPizza from '../assets/otramesa/pizza.jpg'
import fotoPan from '../assets/otramesa/panaderia.jpg'
import logoOm from '../assets/otramesa/logo-om.svg'

const CODIGO = 'K7MQ'
// Un QR de verdad (se puede escanear: dice OTRAMESA-K7MQ), generado al compilar la web
const qr = await QRCode.toString(`OTRAMESA-${CODIGO}`, { type: 'svg', margin: 0, color: { dark: '#1f2e26', light: '#ffffff' } })

// Iconos (trazos de lucide, los mismos que usa la app)
const TRAZOS: Record<string, string> = {
  bolsa: '<path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/>',
  estrella: '<polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>',
  reloj: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  pin: '<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/>',
  brujula: '<circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>',
  mapa: '<polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/><line x1="9" x2="9" y1="3" y2="18"/><line x1="15" x2="15" y1="6" y2="21"/>',
  corazon: '<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>',
  ticket: '<path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/>',
  atras: '<path d="m12 19-7-7 7-7"/><path d="M19 12H5"/>',
  check: '<polyline points="20 6 9 17 4 12"/>',
  abajo: '<path d="m6 9 6 6 6-6"/>',
}
const icono = (n: string) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${TRAZOS[n]}</svg>`

const FRANJA = 'Today 2:00–3:00 PM'
const destacadas = [
  { foto: burgerDoble, nombre: 'Smash Club', tipo: 'Lunch surprise', nota: '4.6', distancia: '120 m', antes: '$45.000', ahora: '$14.500', quedan: '2 left' },
  { foto: burgerBunker, nombre: 'Bunker Burgers', tipo: 'Lunch surprise', nota: '4.7', distancia: '240 m', antes: '$42.000', ahora: '$12.500', quedan: '3 left' },
  { foto: burgerClasica, nombre: 'Kilo Grill', tipo: 'Lunch surprise', nota: '4.5', distancia: '410 m', antes: '$36.000', ahora: '$11.500', quedan: '1 left' },
]
const cerca = [
  { foto: fotoPan, nombre: 'Crumb Bakery', tipo: 'Bakery surprise', nota: '4.8', franja: 'Today 7:00–7:30 PM', antes: '$18.000', ahora: '$6.000', quedan: '2 left' },
  { foto: fotoPizza, nombre: 'Forno 41', tipo: 'Evening surprise', nota: '4.4', franja: 'Today 9:15–10:00 PM', antes: '$54.000', ahora: '$17.500', quedan: '3 left' },
]
const elegida = destacadas[1]
const reparto = [[5, 92], [4, 26], [3, 7], [2, 2], [1, 1]] // estrellas → cuántas valoraciones (128 en total, nota 4.7)

const idioma = idiomaDe(Astro.url)
const pasos = t(idioma, {
  en: ['Swipe through the featured surprises', 'Open the one you like', 'Reserve it', 'Pay with a test card — no real money', 'Get your QR — show it at the restaurant', 'The booking lands in the back office — live'],
  de: ['Durch die empfohlenen Überraschungen wischen', 'Die passende öffnen', 'Reservieren', 'Mit einer Testkarte bezahlen — ohne echtes Geld', 'QR-Code erhalten — im Restaurant zeigen', 'Die Reservierung kommt im Back-Office an — live'],
  es: ['Deslizar las sorpresas destacadas', 'Abrir la que más apetece', 'Reservarla', 'Pagar con una tarjeta de prueba — sin dinero real', 'Recibir el QR — enseñarlo en el restaurante', 'La reserva entra en el back office — en vivo'],
})
const cab = t(idioma, {
  en: { kicker: 'Case 03 · Design + full-stack · ', titulo: 'Otra Mesa', sub: 'good food deserves another table.', aria: 'Case 03 · Otra Mesa', live: '● Live' },
  de: { kicker: 'Case 03 · Design + Full-Stack · ', titulo: 'Otra Mesa', sub: 'gutes Essen verdient einen zweiten Tisch.', aria: 'Case 03 · Otra Mesa', live: '● Live' },
  es: { kicker: 'Caso 03 · Diseño + full-stack · ', titulo: 'Otra Mesa', sub: 'lo bueno merece otra mesa.', aria: 'Caso 03 · Otra Mesa', live: '● En vivo' },
})
const texto = t(idioma, {
  en: {
    entradilla: 'Restaurants and wholesalers in Barranquilla offer the good food they didn’t sell as “house surprises”, at about a third of the price. People nearby reserve one, pay, get a QR code and pick it up. Three apps — for customers, for the businesses and for the admin — on a stack I designed, built and host myself.',
    suave: 'Less food wasted, more life for local restaurants. A near-real product: everything works for real except the money — payments are simulated with test cards.',
    ficha: [['Role', 'Product design · Brand · Full-stack'], ['Stack', 'React · Node/Express · Postgres · MongoDB geo · Web Push · Leaflet/OSM'], ['Scope', 'Customer app · Business portal · Back office · API']],
    acciones: [{ texto: 'Read the case study →', href: enlace(idioma, '/app-otramesa.html'), llena: true }, { texto: 'Try it live ↗', href: 'https://otramesa.danies.trade', externo: true }, { texto: 'Next project ↓', href: '#caso-archivos', siguiente: true }],
  },
  de: {
    entradilla: 'Restaurants und Großhändler in Barranquilla bieten gutes Essen, das sie nicht verkauft haben, als „Überraschung des Hauses“ an — für etwa ein Drittel des Preises. Menschen in der Nähe reservieren, bezahlen, erhalten einen QR-Code und holen ab. Drei Apps — für Kundschaft, Betriebe und Verwaltung — auf einem Stack, den ich selbst gestaltet, entwickelt und gehostet habe.',
    suave: 'Weniger Lebensmittelverschwendung, mehr Leben für lokale Restaurants. Ein fast echtes Produkt: Alles funktioniert wirklich, außer dem Geld — Zahlungen werden mit Testkarten simuliert.',
    ficha: [['Rolle', 'Produktdesign · Marke · Full-Stack'], ['Stack', 'React · Node/Express · Postgres · MongoDB Geo · Web Push · Leaflet/OSM'], ['Umfang', 'Kunden-App · Portal für Betriebe · Back-Office · API']],
    acciones: [{ texto: 'Case Study →', href: enlace(idioma, '/app-otramesa.html'), llena: true }, { texto: 'Live testen ↗', href: 'https://otramesa.danies.trade', externo: true }, { texto: 'Nächstes Projekt ↓', href: '#caso-archivos', siguiente: true }],
  },
  es: {
    entradilla: 'Restaurantes y mayoristas de Barranquilla ofrecen la comida buena que no vendieron como “sorpresas de la casa”, a un tercio del precio. La gente cercana reserva una, paga, recibe un código QR y la recoge. Tres apps — para clientes, para los negocios y para la administración — sobre un stack que diseñé, desarrollé y alojo yo mismo.',
    suave: 'Menos comida desperdiciada, más vida para los restaurantes del barrio. Un producto casi real: todo funciona de verdad menos el dinero — los pagos se simulan con tarjetas de prueba.',
    ficha: [['Rol', 'Diseño de producto · Marca · Full-stack'], ['Stack', 'React · Node/Express · Postgres · MongoDB geo · Web Push · Leaflet/OSM'], ['Alcance', 'App de clientes · Portal de negocios · Back office · API']],
    acciones: [{ texto: 'Leer el caso →', href: enlace(idioma, '/app-otramesa.html'), llena: true }, { texto: 'Probar en vivo ↗', href: 'https://otramesa.danies.trade', externo: true }, { texto: 'Siguiente ↓', href: '#caso-archivos', siguiente: true }],
  },
})
---

<section class="otramesa" id="caso-otramesa" data-otramesa aria-label={cab.aria}>
  <div class="escena contenedor">
    <div class="texto">
      <p class="etiqueta">{cab.kicker}<span class="en-vivo">{cab.live}</span></p>
      <h3 class="titulo">{cab.titulo}<span class="titulo-2">{cab.sub}</span></h3>
      <CasoTexto {...texto} enEscena />
    </div>

    <div class="dispositivos" aria-hidden="true">
      <!-- Portátil con el back office (Gestión: blanco y limpio, como el de verdad) -->
      <div class="portatil">
        <div class="portatil-pantalla">
          <div class="navegador"><span class="puntos"><i></i><i></i><i></i></span><span class="url">otramesa.danies.trade/gestion</span></div>
          <div class="bo">
            <div class="bo-cab">
              <Image src={logoOm} alt="" class="bo-logo" />
              <span class="bo-pildora">Back office</span>
              <span class="bo-quien">Camilo · admin</span>
            </div>
            <div class="bo-tabs"><span>Summary</span><span>Restaurants</span><span class="activa">Bookings</span><span>Requests</span><span>Payments</span></div>
            <div class="bo-cuerpo">
              <div class="bo-entregar">
                <p class="bo-h">Hand over</p>
                <p class="bo-suave">Type the 4-letter code the customer shows.</p>
                <div class="bo-codigo"><span>K7MQ</span><b>✓ Hand over</b></div>
              </div>
              <div class="bo-reservas">
                <p class="bo-suave bo-cuenta">
                  <span class="cambia"><span data-viejo>2 bookings · 1 active</span><span data-nuevo>3 bookings · 2 active</span></span>
                  <span class="bo-live">● Live</span>
                </p>
                <div class="bo-tabla">
                  <div class="fila fila--cab"><span>Code</span><span>Status</span><span>Restaurant · surprise</span></div>
                  <div class="fila fila--nueva" data-fila-nueva><span class="cod">{CODIGO}</span><span><em class="est est--reservada">Reserved</em></span><span>{elegida.nombre}<small>Lunch surprise · {elegida.ahora} paid · 2:00–3:00 PM</small></span></div>
                  <div class="fila"><span class="cod">Q9HW</span><span><em class="est est--reservada">Reserved</em></span><span>Crumb Bakery<small>Bakery surprise · $6.000 paid · 7:00–7:30 PM</small></span></div>
                  <div class="fila"><span class="cod">M3TR</span><span><em class="est est--recogida">Picked up</em></span><span>Nuna Coffee<small>Sweet surprise · $5.500 · 5:00–6:00 PM</small></span></div>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="portatil-base"></div>
      </div>

      <!-- Móvil con la app (en inglés) -->
      <div class="telefono">
        <div class="app">
          <!-- 1 · Descubrir: Sorpresas destacadas que se deslizan + Near you -->
          <div class="capa descubrir" data-pantalla="lista">
            <div class="app-cab">
              <Image src={logoOm} alt="" class="app-logo" />
              <span class="app-ubic"><i class="ico ico--verde" set:html={icono('pin')} /> Alto Prado, Barranquilla <i class="ico" set:html={icono('abajo')} /></span>
              <span class="app-idioma"><span>ES</span><span class="activo">EN</span></span>
            </div>
            <p class="app-h">Featured surprises</p>
            <div class="carrusel"><div class="pista" data-pista>
              {destacadas.map((s, i) => (
                <div class="tarjeta tarjeta--grande" data-destacada={i}>
                  <div class="tarjeta-foto"><Image src={s.foto} alt="" widths={[320, 640]} sizes="260px" /><span class="quedan">{s.quedan}</span><span class="redondo" set:html={icono('corazon')} /></div>
                  <div class="tarjeta-cuerpo">
                    <b>{s.nombre}</b>
                    <span>{s.tipo} · <em class="nota"><i set:html={icono('estrella')} /> {s.nota}</em></span>
                    <span class="pie"><span>{FRANJA} · {s.distancia}</span><span class="precio"><s>{s.antes}</s> <strong>{s.ahora}</strong></span></span>
                  </div>
                </div>
              ))}
            </div></div>
            <div class="pestanas"><span class="activa">All</span><span>Meals</span><span>Bakery</span><span>Groceries</span><span>Sweets</span></div>
            <p class="app-h app-h--fila">Near you <u>See all</u></p>
            <div class="carrusel"><div class="pista">
              {cerca.map((s) => (
                <div class="tarjeta">
                  <div class="tarjeta-foto"><Image src={s.foto} alt="" widths={[240, 480]} sizes="180px" /><span class="quedan">{s.quedan}</span></div>
                  <div class="tarjeta-cuerpo">
                    <b>{s.nombre}</b>
                    <span>{s.tipo} · <em class="nota"><i set:html={icono('estrella')} /> {s.nota}</em></span>
                    <span>{s.franja}</span>
                    <span class="precio precio--derecha"><s>{s.antes}</s> <strong>{s.ahora}</strong></span>
                  </div>
                </div>
              ))}
            </div></div>
            <div class="app-nav">
              <span class="activa"><i set:html={icono('brujula')} />Discover</span><span><i set:html={icono('mapa')} />Explore</span>
              <span><i set:html={icono('corazon')} />Favourites</span><span><i set:html={icono('ticket')} />Bookings</span>
            </div>
          </div>

          <!-- 2 · La ficha: la foto manda, filas cortas, "How people rate it" y la barra Reserve -->
          <div class="capa ficha" data-pantalla="ficha">
            <div class="ficha-portada">
              <Image src={elegida.foto} alt="" widths={[390, 780]} sizes="300px" class="ficha-foto" />
              <span class="redondo redondo--izq" set:html={icono('atras')} /><span class="redondo redondo--der" set:html={icono('corazon')} />
              <div class="ficha-pie"><span class="quedan">{elegida.quedan}</span><p class="ficha-titulo">{elegida.nombre}</p></div>
            </div>
            <div class="ficha-cuerpo">
              <ul class="ficha-datos">
                <li><i set:html={icono('bolsa')} /> Lunch surprise · Burgers</li>
                <li><i set:html={icono('estrella')} /> <b>4.7</b>&nbsp;<span class="suave">· 128 ratings</span></li>
                <li><i set:html={icono('reloj')} /> Pick-up: {FRANJA}</li>
                <li><i set:html={icono('pin')} /> {elegida.distancia} <u>Directions</u></li>
              </ul>
              <p class="ficha-h">What it may include</p>
              <p class="ficha-texto">Today’s burgers, freshly made — beef or chicken, with fries.</p>
              <p class="ficha-ahorro">You save $29.500</p>
              <div class="valoradas">
                <div class="valoradas-cab"><div><p class="ficha-h">How people rate it</p><p class="suave">Based on 128 ratings</p></div><p class="valoradas-nota"><i set:html={icono('estrella')} /> 4.7</p></div>
                {reparto.map(([n, c]) => <p class="barra-fila"><span>{n} <i set:html={icono('estrella')} /></span><span class="barra"><span style={`width:${(c / 92) * 100}%`}></span></span><span class="suave">{c}</span></p>)}
              </div>
            </div>
            <div class="ficha-barra">
              <p class="ficha-precio"><s>{elegida.antes}</s><strong>{elegida.ahora}</strong></p>
              <span class="boton" data-reservar>Reserve</span>
            </div>
          </div>

          <!-- 3 · Pagar con la tarjeta de prueba (hoja que sube encima de la ficha) -->
          <div class="capa pago" data-pantalla="pago">
            <div class="velo"></div>
            <div class="hoja" data-hoja>
              <p class="hoja-titulo">Pay for your booking</p>
              <div class="pago-resumen"><Image src={elegida.foto} alt="" widths={[120]} sizes="40px" /><span><b>{elegida.nombre}</b><small>Lunch surprise · {FRANJA}</small></span><strong>{elegida.ahora}</strong></div>
              <p class="pago-aviso">Demo: only test cards work — no real money moves.</p>
              <p class="campo-etiqueta">Card number</p>
              <p class="campo">4242 4242 4242 4242</p>
              <div class="campos-2"><div><p class="campo-etiqueta">Expiry</p><p class="campo">12/28</p></div><div><p class="campo-etiqueta">CVC</p><p class="campo">123</p></div></div>
              <span class="boton boton--ancho" data-pagar><span class="b-1">Pay {elegida.ahora}</span><span class="b-2">Paying…</span></span>
            </div>
          </div>

          <!-- 4 · Reservada y pagada: código + QR -->
          <div class="capa confirmacion" data-pantalla="confirmacion">
            <span class="check" set:html={icono('check')} />
            <p class="conf-titulo">Reserved!</p>
            <p class="conf-sub">Lunch surprise · {elegida.nombre}</p>
            <div class="conf-tarjeta">
              <p class="conf-kicker">Your pick-up code</p>
              <p class="conf-codigo">{CODIGO}</p>
              <div class="qr" data-qr set:html={qr} />
              <p class="conf-mostrar">Show this at the restaurant.</p>
            </div>
            <p class="conf-linea">Paid {elegida.ahora} · ···· 4242 · Ref. OM-4X7KQ2</p>
            <p class="conf-linea">{FRANJA}</p>
            <span class="conf-boton">See my bookings</span>
          </div>
          <span class="toque" data-toque></span>
        </div>
      </div>
    </div>

    <div class="leyenda">
      <div class="leyenda-pasos">
        {pasos.map((p, i) => <p class="etiqueta paso" data-paso={i}><span>{String(i + 1).padStart(2, '0')}</span> {p}</p>)}
      </div>
      <div class="progreso"><span data-progreso></span></div>
    </div>
  </div>
</section>
<!-- En el móvil, el texto completo del caso va aquí, justo debajo de la animación -->
<div class="contenedor detalle-movil"><CasoTexto {...texto} /></div>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  const om = document.querySelector<HTMLElement>('[data-otramesa]')!
  const capa = (id: string) => om.querySelector(`[data-pantalla="${id}"]`)
  const toque = om.querySelector('[data-toque]')
  const pasos = om.querySelectorAll('[data-paso]')
  const filaNueva = om.querySelector<HTMLElement>('[data-fila-nueva]')!
  const pista = om.querySelector<HTMLElement>('[data-pista]')!
  const destacadas = om.querySelectorAll<HTMLElement>('[data-destacada]')

  const mm = gsap.matchMedia()
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    om.classList.add('otramesa--animado')
    gsap.set(om.querySelectorAll('[data-pantalla]'), { autoAlpha: 0 })
    gsap.set(capa('lista'), { autoAlpha: 1 })
    gsap.set(pasos, { autoAlpha: 0, y: 10 }); gsap.set(pasos[0], { autoAlpha: 1, y: 0 })
    gsap.set(filaNueva, { autoAlpha: 0, y: -14 })
    gsap.set(om.querySelector('[data-nuevo]'), { autoAlpha: 0 })
    gsap.set(om.querySelector('.b-2'), { autoAlpha: 0 })
    gsap.set(om.querySelector('[data-qr]'), { autoAlpha: 0, scale: 0.85 })
    gsap.set(toque, { autoAlpha: 0, scale: 0.4 })

    const tl = gsap.timeline({
      defaults: { ease: 'power2.inOut', duration: 0.5 },
      scrollTrigger: { trigger: om, start: 'top top', end: 'bottom bottom', scrub: 0.6, invalidateOnRefresh: true },
    })
    const paso = (i: number, t: number) => {
      tl.to(pasos[i - 1], { autoAlpha: 0, y: -10, duration: 0.2 }, t).to(pasos[i], { autoAlpha: 1, y: 0, duration: 0.2 }, t + 0.15)
    }
    // El dedo apunta al centro REAL de lo que toca (medido, no a ojo): si cambian fotos o tamaños, no se descoloca.
    // offsetLeft/offsetTop ignoran los movimientos de GSAP, así que la medida vale en cualquier momento del scroll.
    const centro = (el: HTMLElement) => {
      const app = el.closest<HTMLElement>('.app')!
      let x = el.offsetWidth / 2, y = el.offsetHeight / 2, n: HTMLElement | null = el
      while (n && n !== app) { x += n.offsetLeft; y += n.offsetTop; n = n.offsetParent as HTMLElement | null }
      return { x: (x / app.clientWidth) * 100, y: (y / app.clientHeight) * 100 }
    }
    const tocar = (el: HTMLElement, t: number) => {
      tl.set(toque, { left: () => `${centro(el).x}%`, top: () => `${centro(el).y}%` }, t)
        .to(toque, { autoAlpha: 1, scale: 1, duration: 0.12, ease: 'power1.out' }, t)
        .to(toque, { autoAlpha: 0, scale: 1.6, duration: 0.25 }, t + 0.14)
    }
    // Lo que se desliza: la tarjeta de Bunker Burgers (la 2.ª) queda justo donde estaba la 1.ª
    const deslizar = () => -(destacadas[1].offsetLeft - destacadas[0].offsetLeft)

    // 01 · el dedo arrastra las destacadas hacia la izquierda: aparece Bunker Burgers
    tl.set(toque, { left: () => `${centro(destacadas[0]).x + 22}%`, top: () => `${centro(destacadas[0]).y}%` }, 0.25)
      .to(toque, { autoAlpha: 1, scale: 1, duration: 0.1 }, 0.25)
      .to(toque, { left: () => `${centro(destacadas[0]).x - 22}%`, duration: 0.45, ease: 'power1.inOut' }, 0.35)
      .to(pista, { x: deslizar, duration: 0.5, ease: 'power2.out' }, 0.35)
      .to(toque, { autoAlpha: 0, scale: 0.6, duration: 0.15 }, 0.8)
    // 02 · toque en Bunker Burgers (está ahora en el sitio de la primera) → se abre su ficha desde abajo
    paso(1, 1.0); tocar(destacadas[0], 1.1)
    tl.set(capa('ficha'), { autoAlpha: 1, yPercent: 100 }, 1.25).to(capa('ficha'), { yPercent: 0, duration: 0.45 }, 1.25)
      .to(capa('lista'), { autoAlpha: 0, duration: 0.01 }, 1.7)
    // 03 · toque en "Reserve" → sube la hoja de pago
    paso(2, 2.0); tocar(om.querySelector<HTMLElement>('[data-reservar]')!, 2.1)
    tl.set(capa('pago'), { autoAlpha: 1 }, 2.25)
      .fromTo(om.querySelector('.velo'), { autoAlpha: 0 }, { autoAlpha: 1, duration: 0.25 }, 2.25)
      .fromTo(om.querySelector('[data-hoja]'), { yPercent: 100 }, { yPercent: 0, duration: 0.4, ease: 'power3.out' }, 2.25)
    // 04 · pagar con la tarjeta de prueba → "Paying…"
    paso(3, 2.8); tocar(om.querySelector<HTMLElement>('[data-pagar]')!, 2.95)
    tl.to(om.querySelector('.b-1'), { autoAlpha: 0, duration: 0.1 }, 3.07).to(om.querySelector('.b-2'), { autoAlpha: 1, duration: 0.1 }, 3.09)
      .to(om.querySelector('[data-pagar]'), { scale: 0.97, duration: 0.1, yoyo: true, repeat: 1 }, 3.07)
    // 05 · reservada y pagada: código y QR
    paso(4, 3.5)
    tl.to(capa('confirmacion'), { autoAlpha: 1, duration: 0.35 }, 3.5)
      .to(om.querySelector('[data-qr]'), { autoAlpha: 1, scale: 1, duration: 0.35, ease: 'back.out(1.6)' }, 3.7)
      .to([capa('ficha'), capa('pago')], { autoAlpha: 0, duration: 0.01 }, 3.9)
    // 06 · en ese momento, la reserva entra en el back office
    paso(5, 4.2)
    tl.to(filaNueva, { autoAlpha: 1, y: 0, duration: 0.35, ease: 'back.out(1.6)' }, 4.25)
      .to(om.querySelector('[data-viejo]'), { autoAlpha: 0, duration: 0.15 }, 4.25)
      .to(om.querySelector('[data-nuevo]'), { autoAlpha: 1, duration: 0.15 }, 4.3)
      .fromTo(filaNueva, { boxShadow: 'inset 0 0 0 0 rgb(210 110 40 / 0)' }, { boxShadow: 'inset 0 0 0 2px rgb(210 110 40 / 1)', duration: 0.25, yoyo: true, repeat: 1 }, 4.6)
    tl.to({}, { duration: 0.7 })
    tl.fromTo(om.querySelector('[data-progreso]'), { scaleX: 0 }, { scaleX: 1, ease: 'none', duration: tl.duration() }, 0)

    return () => om.classList.remove('otramesa--animado')
  })
</script>

