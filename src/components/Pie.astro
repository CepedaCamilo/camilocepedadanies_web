---
import { sitio } from '../sitio'
import { idiomaDe, enlace, t } from '../i18n'
const año = new Date().getFullYear()
const idioma = idiomaDe(Astro.url)
const textos = t(idioma, {
  en: { impressum: 'Legal notice', datenschutz: 'Privacy' },
  de: { impressum: 'Impressum', datenschutz: 'Datenschutz' },
  es: { impressum: 'Aviso legal', datenschutz: 'Privacidad' },
})
---

<footer class="pie contenedor">
  <span class="etiqueta">© {año} {sitio.nombre}</span>
  <nav aria-label="Legal" class="etiqueta">
    <a href={`mailto:${sitio.email}`}>{sitio.email}</a>
    <a href={enlace(idioma, '/impressum.html')}>{textos.impressum}</a>
    <a href={enlace(idioma, '/datenschutz.html')}>{textos.datenschutz}</a>
  </nav>
</footer>

<style>
  .pie {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--espacio-4);
    padding-block: var(--espacio-6) var(--espacio-7);
    border-top: var(--linea-fina) solid var(--color-linea);
  }
  nav { display: flex; flex-wrap: wrap; gap: var(--espacio-5); }
</style>
