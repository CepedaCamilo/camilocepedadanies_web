---
import { idiomaDe, enlace, t } from '../i18n'
// Design · Caso 02: BIKE Transalp · TOUR Transalp (campaña integrada, en HAVE A GOOD ONE).
// Los dispositivos se dibujan en HTML/CSS (nítidos, sin recortes de fondo) y cada uno flota en su propia capa.
// Con el scroll, el foco pasa de uno a otro y las pantallas cambian de contenido.
// Las imágenes de dentro de las pantallas salen de `npm run transalp` (scripts/pantallas-transalp.mjs → public/transalp/).
import TransalpDispositivos from './TransalpDispositivos.astro'
const pasos = t(idiomaDe(Astro.url), {
  en: ["Launch trailer · YouTube & web", "Social campaign · countdown & stories", "Route reveal", "Community & event pages"],
  de: ["Launch-Trailer · YouTube & Web", "Social-Kampagne · Countdown & Stories", "Routenenthüllung", "Community- & Eventseiten"],
  es: ["Tráiler de lanzamiento · YouTube y web", "Campaña en redes · cuenta atrás y stories", "Presentación de la ruta", "Comunidad y páginas del evento"],
})
import CasoTexto from './CasoTexto.astro'
// El texto largo del caso (se usa junto a la animación y, en el móvil, debajo de ella)
const idioma = idiomaDe(Astro.url)
// Kicker, título y nombre accesible del caso
const cab = t(idioma, {"en": {"kicker": "Case 02 · BIKE Transalp · TOUR Transalp", "titulo": "Integrated campaign design.", "sub": "", "aria": "Case 02 · BIKE Transalp · TOUR Transalp", "live": "● Live"}, "de": {"kicker": "Case 02 · BIKE Transalp · TOUR Transalp", "titulo": "Integriertes Kampagnendesign.", "sub": "", "aria": "Case 02 · BIKE Transalp · TOUR Transalp", "live": "● Live"}, "es": {"kicker": "Caso 02 · BIKE Transalp · TOUR Transalp", "titulo": "Diseño de campañas integradas.", "sub": "", "aria": "Caso 02 · BIKE Transalp · TOUR Transalp", "live": "● En vivo"}})
const texto = t(idioma, {
  en: {
    entradilla: "Campaign work developed during my time at HAVE A GOOD ONE — shaping the visual communication for two major alpine cycling events across digital and promotional touchpoints.",
    suave: "From launch trailers and route reveals to social campaigns and web assets, I worked on communication designed to build anticipation, engage participants and carry each event’s identity consistently throughout the campaign cycle.",
    ficha: [["Role", "Graphic Direction · Campaign Design · Motion"], ["Context", "HAVE A GOOD ONE · Event campaign communication"], ["Scope", "Social · Motion · Web · Event Promotion"]],
    acciones: [{ texto: "Read the case study →", href: enlace(idioma, "/integrated-campaign-communication.html"), llena: true }, { texto: "Trailer ↗", href: "https://www.youtube.com/watch?v=USL3U4n7VhQ", externo: true }, { texto: "Next project ↓", href: "#caso-bridge", siguiente: true }],
  },
  de: {
    entradilla: "Kampagnenarbeit aus meiner Zeit bei HAVE A GOOD ONE — die visuelle Kommunikation für zwei große alpine Radsport-Events, über digitale und werbliche Kanäle hinweg.",
    suave: "Von Launch-Trailern und Routenenthüllungen bis zu Social-Kampagnen und Web-Assets: Kommunikation, die Vorfreude aufbaut, Teilnehmende einbindet und die Identität jedes Events über den gesamten Kampagnenzyklus hinweg konsistent trägt.",
    ficha: [["Rolle", "Grafische Leitung · Kampagnendesign · Motion"], ["Kontext", "HAVE A GOOD ONE · Kampagnenkommunikation für Events"], ["Umfang", "Social · Motion · Web · Eventpromotion"]],
    acciones: [{ texto: "Case Study →", href: enlace(idioma, "/integrated-campaign-communication.html"), llena: true }, { texto: "Trailer ↗", href: "https://www.youtube.com/watch?v=USL3U4n7VhQ", externo: true }, { texto: "Nächstes Projekt ↓", href: "#caso-bridge", siguiente: true }],
  },
  es: {
    entradilla: "Trabajo de campaña desarrollado durante mi etapa en HAVE A GOOD ONE — dando forma a la comunicación visual de dos grandes eventos de ciclismo alpino en canales digitales y promocionales.",
    suave: "De los tráileres de lanzamiento y la presentación de rutas a las campañas en redes y los recursos web, trabajé en una comunicación pensada para crear expectación, implicar a los participantes y mantener la identidad de cada evento durante todo el ciclo de campaña.",
    ficha: [["Rol", "Dirección gráfica · Diseño de campaña · Motion"], ["Contexto", "HAVE A GOOD ONE · Comunicación de campaña para eventos"], ["Alcance", "Redes · Motion · Web · Promoción de eventos"]],
    acciones: [{ texto: "Leer el caso →", href: enlace(idioma, "/integrated-campaign-communication.html"), llena: true }, { texto: "Tráiler ↗", href: "https://www.youtube.com/watch?v=USL3U4n7VhQ", externo: true }, { texto: "Siguiente ↓", href: "#caso-bridge", siguiente: true }],
  },
})
---

<section class="transalp" id="caso-transalp" data-transalp aria-label={cab.aria}>
  <div class="escena contenedor">
    <div class="texto">
      <p class="etiqueta">{cab.kicker}</p>
      <h3 class="titulo">{cab.titulo}</h3>
      <CasoTexto {...texto} enEscena />
    </div>

    <!-- El "escaparate": 4 dispositivos (componente propio; aquí los mueve el scroll) -->
    <div class="escenario-celda"><TransalpDispositivos /></div>

    <div class="leyenda">
      <div class="leyenda-pasos">
        {pasos.map((p, i) => <p class="etiqueta paso" data-paso={i}><span>{String(i + 1).padStart(2, '0')}</span> {p}</p>)}
      </div>
      <div class="progreso"><span data-progreso></span></div>
    </div>
  </div>
</section>
<!-- En móvil la escena fija no tiene sitio para los botones: van aquí, justo debajo de la animación -->
<div class="contenedor detalle-movil"><CasoTexto {...texto} /></div>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  const raiz = document.querySelector<HTMLElement>('[data-transalp]')!
  const disp = (id: string) => raiz.querySelector<HTMLElement>(`[data-disp="${id}"]`)!
  const post = (id: string) => raiz.querySelector<HTMLElement>(`[data-post="${id}"]`)!
  const pasos = raiz.querySelectorAll('[data-paso]')
  const todos = raiz.querySelectorAll<HTMLElement>('[data-disp]')

  const mm = gsap.matchMedia()
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    raiz.classList.add('transalp--animado')
    gsap.set(pasos, { autoAlpha: 0, y: 10 }); gsap.set(pasos[0], { autoAlpha: 1, y: 0 })
    gsap.set(raiz.querySelectorAll('[data-post]'), { autoAlpha: 0, yPercent: 8 })
    gsap.set(post('bruneck'), { autoAlpha: 1, yPercent: 0 })

    // Al llegar: los dispositivos están "abiertos" en el espacio, girados y separados; el scroll los junta
    gsap.set(disp('pantalla'), { yPercent: -6, scale: 0.94, rotateX: 8 })
    gsap.set(disp('laptop'), { xPercent: 14, yPercent: 10, rotateY: -22, rotateZ: 2 })
    gsap.set(disp('tablet'), { xPercent: -18, yPercent: -8, rotateY: 24, rotateZ: -4 })
    gsap.set(disp('movil'), { xPercent: -30, yPercent: 18, rotateY: 28, rotateZ: -8 })

    const tl = gsap.timeline({
      defaults: { ease: 'power2.inOut', duration: 0.6 },
      scrollTrigger: { trigger: raiz, start: 'top top', end: 'bottom bottom', scrub: 0.8 },
    })
    // Foco, como una cámara: el protagonista se acerca y se ve nítido; el resto se aleja, gris y desenfocado (pero sólido)
    gsap.set(todos, { filter: 'grayscale(0) blur(0px)' })
    const foco = (ids: string[], t: number) => {
      todos.forEach((d) => {
        const activo = ids.includes(d.dataset.disp!)
        tl.to(d, { scale: activo ? 1.06 : 0.96, filter: activo ? 'grayscale(0) blur(0px)' : 'grayscale(1) blur(1.5px)', duration: 0.5 }, t)
      })
    }
    const paso = (i: number, t: number) => {
      tl.to(pasos[i - 1], { autoAlpha: 0, y: -10, duration: 0.2 }, t)
        .to(pasos[i], { autoAlpha: 1, y: 0, duration: 0.2 }, t + 0.15)
    }
    const cambiarPost = (de: string, a: string, t: number) => {
      tl.to(post(de), { autoAlpha: 0, yPercent: -8, duration: 0.3 }, t)
        .to(post(a), { autoAlpha: 1, yPercent: 0, duration: 0.3 }, t + 0.1)
    }

    // 0 → 1: todo gravita hasta la composición
    tl.to(todos, { xPercent: 0, yPercent: 0, rotateX: 0, rotateY: 0, rotateZ: 0, scale: 1, duration: 1, stagger: 0.08, ease: 'power3.out' }, 0)
    // 01 Tráiler: la pantalla grande al frente; la imagen se acerca despacio (como una cámara)
    foco(['pantalla'], 1.1)
    tl.fromTo(raiz.querySelector('[data-trailer]'), { scale: 1.14, xPercent: 3 }, { scale: 1, xPercent: 0, duration: 1.6, ease: 'none' }, 1.1)
    // 02 Campaña social: móvil y tablet al frente; los posts van pasando en la tablet
    paso(1, 2.3); foco(['movil', 'tablet'], 2.3)
    cambiarPost('bruneck', 'regla', 2.8)
    cambiarPost('regla', 'fecha', 3.2)
    cambiarPost('fecha', 'ciclista', 3.6)
    // 03 Ruta: la tablet sola, con el mapa de la ruta
    paso(2, 4.1); foco(['tablet'], 4.1)
    cambiarPost('ciclista', 'ruta', 4.2)
    // 04 Comunidad y páginas del evento: el portátil
    paso(3, 5.0); foco(['laptop'], 5.0)
    // Final: todos juntos otra vez
    foco(['pantalla', 'laptop', 'tablet', 'movil'], 5.9)
    tl.to(todos, { scale: 1, duration: 0.5 }, 5.9)
    tl.fromTo(raiz.querySelector('[data-progreso]'), { scaleX: 0 }, { scaleX: 1, duration: 6.4, ease: 'none' }, 0)
    return () => raiz.classList.remove('transalp--animado')
  })
</script>

<style>
  .escena {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    grid-template-areas: 'texto escenario' 'leyenda escenario';
    align-items: center;
    column-gap: var(--espacio-7);
    padding-block: var(--espacio-7);
  }
  .transalp--animado { height: calc(460svh - var(--alto-cabecera)); }
  .transalp--animado .escena {
    position: sticky; top: calc(var(--alto-cabecera) + var(--alto-barra-trabajos));
    height: calc(100svh - var(--alto-cabecera) - var(--alto-barra-trabajos));
    align-content: center; padding-block: var(--espacio-5);
  }

  .texto { grid-area: texto; display: flex; flex-direction: column; gap: var(--espacio-4); }
  .titulo { font-size: var(--titulo-2); font-weight: var(--peso-fino); letter-spacing: var(--tracking-titulo); line-height: 1.02; }

  /* ---------- El escaparate (los dispositivos están en TransalpDispositivos.astro) ---------- */
  .escenario-celda { grid-area: escenario; width: 100%; min-width: 0; }


  /* ---------- Leyenda ---------- */
  .leyenda { grid-area: leyenda; align-self: end; display: flex; flex-direction: column; gap: var(--espacio-3); padding-top: var(--espacio-5); }
  .leyenda-pasos { display: grid; }
  .paso { grid-area: 1 / 1; margin: 0; }
  .paso span { color: var(--color-acento); }
  .transalp:not(.transalp--animado) .paso:not(:first-child) { display: none; }
  .progreso { height: 2px; border-radius: 2px; background: var(--color-linea); overflow: hidden; max-width: 22rem; }
  .progreso span { display: block; height: 100%; background: var(--color-acento); transform-origin: left; transform: scaleX(0); }

  @media (max-width: 900px) {
    .escena { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'texto' 'escenario' 'leyenda'; row-gap: var(--espacio-5); }
    .transalp--animado .escena { align-content: start; overflow: hidden; }
    .escenario-celda { margin-top: var(--espacio-4); }
  }
</style>
