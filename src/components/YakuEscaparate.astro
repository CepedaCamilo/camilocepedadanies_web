---
import { idiomaDe, enlace, t } from '../i18n'
// Caso 01 · Yaku: la app EN USO, guiada por el scroll (como el chat del hero).
// El móvil enseña capturas REALES de yaku.danies.trade (npm run capturas-yaku) y la tablet
// de cocina recibe el pedido al mismo tiempo: así se entiende el tiempo real en segundos.
import { Image, getImage } from 'astro:assets'
import cartaLargaOscuro from '../assets/yaku/oscuro-carta-larga.png'
import cartaLargaClaro from '../assets/yaku/claro-carta-larga.png'
import platoOscuro from '../assets/yaku/oscuro-plato.png'
import platoClaro from '../assets/yaku/claro-plato.png'
import cartaPedidoOscuro from '../assets/yaku/oscuro-carta-pedido.png'
import cartaPedidoClaro from '../assets/yaku/claro-carta-pedido.png'
import pedidoOscuro from '../assets/yaku/oscuro-pedido.png'
import pedidoClaro from '../assets/yaku/claro-pedido.png'
import recibidoOscuro from '../assets/yaku/oscuro-estado-recibido.png'
import recibidoClaro from '../assets/yaku/claro-estado-recibido.png'
import preparandoOscuro from '../assets/yaku/oscuro-estado-preparando.png'
import preparandoClaro from '../assets/yaku/claro-estado-preparando.png'
import logoY from '../assets/yaku/y-negra.png'

// Las pantallas del móvil, en orden. (La carta es una captura larga que se desliza.)
const pantallas = [
  { id: 'carta', claro: cartaLargaClaro, oscuro: cartaLargaOscuro, larga: true },
  { id: 'plato', claro: platoClaro, oscuro: platoOscuro },
  { id: 'carta-pedido', claro: cartaPedidoClaro, oscuro: cartaPedidoOscuro },
  { id: 'pedido', claro: pedidoClaro, oscuro: pedidoOscuro },
  { id: 'recibido', claro: recibidoClaro, oscuro: recibidoOscuro },
  { id: 'preparando', claro: preparandoClaro, oscuro: preparandoOscuro },
]
// Las capturas se preparan aquí (WebP de 390 y 780 px, como <Image>), pero la dirección va en data-src/data-srcset:
// el script las descarga cuando Yaku está cerca (ver abajo), no nada más entrar en la web.
const TAMANOS = '(max-width: 900px) 70vw, 300px'
const preparar = (src: ImageMetadata) => getImage({ src, widths: [390, 780], sizes: TAMANOS })
const capturas = await Promise.all(pantallas.map(async (p) => ({ ...p, claro: await preparar(p.claro), oscuro: await preparar(p.oscuro) })))
// Cuánto baja la carta larga para enseñar la rejilla (en % de su propia altura)
const bajadaCarta = Math.round(((cartaLargaOscuro.height - 1688) / cartaLargaOscuro.height) * 45)

const pasos = t(idiomaDe(Astro.url), {
  en: ["Scan the table QR · browse the menu", "Open a dish", "Add it to the order", "Send it to the kitchen", "The kitchen gets it — live", "Status updates on the phone"],
  de: ["QR-Code am Tisch scannen · Karte ansehen", "Ein Gericht öffnen", "Zur Bestellung hinzufügen", "An die Küche senden", "Die Küche erhält sie — live", "Der Status erscheint auf dem Handy"],
  es: ["Escanear el QR de la mesa · ver la carta", "Abrir un plato", "Añadirlo al pedido", "Enviarlo a la cocina", "La cocina lo recibe — en vivo", "El estado se actualiza en el móvil"],
})
import CasoTexto from './CasoTexto.astro'
// El texto largo del caso (se usa junto a la animación y, en el móvil, debajo de ella)
const idioma = idiomaDe(Astro.url)
// Kicker, título y nombre accesible del caso
const cab = t(idioma, {"en": {"kicker": "Case 01 · Design + development · ", "titulo": "Yaku", "sub": "order from the table.", "aria": "Case 01 · Yaku", "live": "● Live"}, "de": {"kicker": "Case 01 · Design + Entwicklung · ", "titulo": "Yaku", "sub": "am Tisch bestellen.", "aria": "Case 01 · Yaku", "live": "● Live"}, "es": {"kicker": "Caso 01 · Diseño + desarrollo · ", "titulo": "Yaku", "sub": "pedir desde la mesa.", "aria": "Caso 01 · Yaku", "live": "● En vivo"}})
const texto = t(idioma, {
  en: {
    entradilla: "A QR code on every table, a menu that sells with photography and a kitchen screen that updates in real time. For a Peruvian–Mexican restaurant in Hamburg — designed, built and hosted by me.",
    ficha: [["Role", "Product design · Front-end · Back-end"], ["Stack", "React · Supabase Realtime · Postgres RLS"], ["Scope", "Guest app · Kitchen screen · QR system"]],
    acciones: [{ texto: "Read the case study →", href: enlace(idioma, "/app-yaku.html"), llena: true }, { texto: "Try it live ↗", href: "https://yaku.danies.trade/?mesa=demo", externo: true }, { texto: "Next project ↓", href: "#caso-chat", siguiente: true }],
  },
  de: {
    entradilla: "Ein QR-Code auf jedem Tisch, eine Karte, die mit Fotografie verkauft, und ein Küchenbildschirm, der sich in Echtzeit aktualisiert. Für ein peruanisch-mexikanisches Restaurant in Hamburg — von mir gestaltet, entwickelt und gehostet.",
    ficha: [["Rolle", "Produktdesign · Front-end · Back-end"], ["Stack", "React · Supabase Realtime · Postgres RLS"], ["Umfang", "Gäste-App · Küchenbildschirm · QR-System"]],
    acciones: [{ texto: "Case Study →", href: enlace(idioma, "/app-yaku.html"), llena: true }, { texto: "Live testen ↗", href: "https://yaku.danies.trade/?mesa=demo", externo: true }, { texto: "Nächstes Projekt ↓", href: "#caso-chat", siguiente: true }],
  },
  es: {
    entradilla: "Un código QR en cada mesa, una carta que vende con fotografía y una pantalla de cocina que se actualiza en tiempo real. Para un restaurante peruano-mexicano en Hamburgo — diseñado, desarrollado y alojado por mí.",
    ficha: [["Rol", "Diseño de producto · Front-end · Back-end"], ["Stack", "React · Supabase Realtime · Postgres RLS"], ["Alcance", "App para clientes · Pantalla de cocina · Sistema QR"]],
    acciones: [{ texto: "Leer el caso →", href: enlace(idioma, "/app-yaku.html"), llena: true }, { texto: "Probar en vivo ↗", href: "https://yaku.danies.trade/?mesa=demo", externo: true }, { texto: "Siguiente ↓", href: "#caso-chat", siguiente: true }],
  },
})
---

<section class="yaku" data-yaku aria-label={cab.aria}>
  <div class="escena contenedor">
    <div class="texto">
      <p class="etiqueta">{cab.kicker}<span class="en-vivo">{cab.live}</span></p>
      <h3 class="titulo">{cab.titulo}<span class="titulo-2">{cab.sub}</span></h3>
      <CasoTexto {...texto} enEscena />
    </div>

    <div class="dispositivos" aria-hidden="true">
      <!-- Tablet de cocina (HTML, como la pantalla real de /cocina) -->
      <div class="tablet">
        <div class="cocina">
          <div class="cocina-barra"><Image src={logoY} alt="" class="cocina-logo" height={48} /><span>Bestellungen</span><span class="cocina-live">● Live</span></div>
          <div class="cocina-columnas">
            <div class="cocina-col"><p>Neu</p></div>
            <div class="cocina-col"><p>In Zubereitung</p></div>
            <div class="cocina-col"><p>Serviert</p></div>
            <article class="ticket" data-ticket>
              <div class="ticket-cab"><span>Tisch 99</span><span>0 min</span></div>
              <p class="ticket-plato"><b>1×</b> Mar Nikkei</p>
              <span class="ticket-boton" data-ticket-boton><span class="b-starten">Starten →</span><span class="b-serviert">Serviert →</span></span>
            </article>
          </div>
        </div>
      </div>

      <!-- Móvil con la app real -->
      <div class="telefono">
        <div class="pantalla-app">
          {capturas.map((p, i) => (
            <div class={`capa${p.larga ? ' capa--larga' : ''}`} data-pantalla={p.id} style={i === 0 ? '' : 'visibility:hidden'}>
              {(['claro', 'oscuro'] as const).map((modo) => (
                <img class={`solo-${modo}`} alt="" data-src={p[modo].src} data-srcset={p[modo].srcSet.attribute} sizes={TAMANOS}
                  width={p[modo].attributes.width} height={p[modo].attributes.height} decoding="async" />
              ))}
            </div>
          ))}
          <span class="toque" data-toque></span>
        </div>
      </div>
    </div>

    <div class="leyenda">
      <div class="leyenda-pasos">
        {pasos.map((p, i) => <p class="etiqueta paso" data-paso={i}><span>{String(i + 1).padStart(2, '0')}</span> {p}</p>)}
      </div>
      <div class="progreso"><span data-progreso></span></div>
    </div>
  </div>
</section>
<!-- En el móvil, el texto completo del caso va aquí, justo debajo de la animación -->
<div class="contenedor detalle-movil"><CasoTexto {...texto} /></div>

<script define:vars={{ bajadaCarta }}>
  window.__yakuBajada = bajadaCarta
</script>

<script>
  import { gsap } from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  gsap.registerPlugin(ScrollTrigger)

  const yaku = document.querySelector<HTMLElement>('[data-yaku]')!

  // Las capturas (modo claro y oscuro) no se descargan al entrar en la web, sino cuando Yaku está
  // a unas dos pantallas: así no compiten con el hero y aun así están listas antes de verse.
  // (El vigía empieza a mirar cuando la página ya tiene su altura real: antes del JavaScript el hero es corto
  // y Yaku parecería estar cerca.)
  const vigia = new IntersectionObserver(([e]) => {
    if (!e.isIntersecting) return
    yaku.querySelectorAll<HTMLImageElement>('img[data-src]').forEach((img) => {
      img.srcset = img.dataset.srcset!
      img.src = img.dataset.src!
    })
    vigia.disconnect()
  }, { rootMargin: '200% 0px' })
  addEventListener('DOMContentLoaded', () => requestAnimationFrame(() => vigia.observe(yaku)))
  const capa = (id: string) => yaku.querySelector(`[data-pantalla="${id}"]`)
  const toque = yaku.querySelector('[data-toque]')
  const pasos = yaku.querySelectorAll('[data-paso]')
  const ticket = yaku.querySelector<HTMLElement>('[data-ticket]')!

  const mm = gsap.matchMedia()
  mm.add('(prefers-reduced-motion: no-preference)', () => {
    yaku.classList.add('yaku--animado')
    gsap.set(yaku.querySelectorAll('[data-pantalla]'), { autoAlpha: 0 })
    gsap.set(capa('carta'), { autoAlpha: 1 })
    gsap.set(pasos, { autoAlpha: 0, y: 10 }); gsap.set(pasos[0], { autoAlpha: 1, y: 0 })
    gsap.set(ticket, { autoAlpha: 0, y: -20, scale: 0.95 })
    gsap.set(toque, { autoAlpha: 0, scale: 0.4 })

    const tl = gsap.timeline({
      defaults: { ease: 'power2.inOut', duration: 0.5 },
      scrollTrigger: { trigger: yaku, start: 'top top', end: 'bottom bottom', scrub: 0.6 },
    })
    const paso = (i: number, t: number) => {
      tl.to(pasos[i - 1], { autoAlpha: 0, y: -10, duration: 0.2 }, t)
        .to(pasos[i], { autoAlpha: 1, y: 0, duration: 0.2 }, t + 0.15)
    }
    // Un "toque" de dedo en un punto de la pantalla (en % de la pantalla)
    const tocar = (x: number, y: number, t: number) => {
      tl.set(toque, { left: `${x}%`, top: `${y}%` }, t)
        .to(toque, { autoAlpha: 1, scale: 1, duration: 0.12, ease: 'power1.out' }, t)
        .to(toque, { autoAlpha: 0, scale: 1.6, duration: 0.25 }, t + 0.14)
    }
    // Cambio de pantalla: la nueva entra deslizándose
    const entrar = (id: string, t: number, desde: 'abajo' | 'derecha' | 'fundido' = 'fundido') => {
      if (desde === 'fundido') {
        tl.to(capa(id), { autoAlpha: 1, duration: 0.4 }, t)
      } else {
        // se coloca fuera de la pantalla justo antes y entra deslizándose
        tl.set(capa(id), { autoAlpha: 1, [desde === 'abajo' ? 'yPercent' : 'xPercent']: 100 }, t)
          .to(capa(id), { yPercent: 0, xPercent: 0, duration: 0.45 }, t)
      }
    }
    const salir = (id: string, t: number) => tl.to(capa(id), { autoAlpha: 0, duration: 0.01 }, t)

    // 01 · la carta baja para enseñar los platos y vuelve arriba
    const imagenesCarta = capa('carta')!.querySelectorAll('img')
    tl.to(imagenesCarta, { yPercent: -(window as any).__yakuBajada, duration: 0.9 }, 0)
      .to(imagenesCarta, { yPercent: 0, duration: 0.6 }, 1.0)
    // 02 · toque en Mar Nikkei → se abre el plato desde abajo
    paso(1, 1.6); tocar(26, 73, 1.7); entrar('plato', 1.85, 'abajo'); salir('carta', 2.3)
    // 03 · toque en "Add" → vuelve a la carta con la barra de pedido
    paso(2, 2.7); tocar(66, 94, 2.8); entrar('carta-pedido', 2.95); salir('plato', 3.4)
    // 04 · toque en la barra → pantalla del pedido → toque en "Place order"
    paso(3, 3.7); tocar(50, 94.5, 3.8); entrar('pedido', 3.95, 'derecha'); salir('carta-pedido', 4.4)
    tocar(50, 75.6, 4.7); entrar('recibido', 4.85); salir('pedido', 5.3)
    // 05 · en ese mismo momento, el ticket aparece en la cocina
    paso(4, 4.9)
    tl.to(ticket, { autoAlpha: 1, y: 0, scale: 1, duration: 0.35, ease: 'back.out(1.6)' }, 4.95)
      .fromTo(ticket, { boxShadow: '0 0 0 0 rgb(242 179 61 / 0)' }, { boxShadow: '0 0 0 6px rgb(242 179 61 / 0.9)', duration: 0.2, yoyo: true, repeat: 1 }, 5.3)
    // 06 · la cocina pulsa "Starten" → el ticket pasa de columna y el móvil cambia de estado
    paso(5, 5.9)
    tl.to(yaku.querySelector('[data-ticket-boton]'), { scale: 0.9, duration: 0.1, yoyo: true, repeat: 1 }, 6.0)
      .call(() => ticket.classList.remove('ticket--preparando'), [], 6.19)
      .to(ticket, { x: () => ticket.offsetWidth + 10, duration: 0.5 }, 6.2)
      .call(() => ticket.classList.add('ticket--preparando'), [], 6.21)
      .to(capa('preparando'), { autoAlpha: 1, duration: 0.4 }, 6.4)
    tl.to({}, { duration: 0.7 })
    tl.fromTo(yaku.querySelector('[data-progreso]'), { scaleX: 0 }, { scaleX: 1, ease: 'none', duration: tl.duration() }, 0)

    return () => yaku.classList.remove('yaku--animado')
  })
</script>

<style>
  .escena {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    grid-template-areas: 'texto dispositivos' 'leyenda dispositivos';
    align-items: center;
    column-gap: var(--espacio-7);
    padding-block: var(--espacio-7);
  }
  .yaku--animado { height: calc(460svh - var(--alto-cabecera)); }
  .yaku--animado .escena {
    position: sticky; top: calc(var(--alto-cabecera) + var(--alto-barra-trabajos));
    height: calc(100svh - var(--alto-cabecera) - var(--alto-barra-trabajos));
    align-content: center; padding-block: var(--espacio-5);
  }

  .texto { grid-area: texto; display: flex; flex-direction: column; gap: var(--espacio-4); }
  .en-vivo { color: var(--color-acento); }
  .titulo-2 { display: block; color: var(--color-texto-suave); }
  .titulo { font-size: var(--titulo-2); font-weight: var(--peso-fino); letter-spacing: var(--tracking-titulo); line-height: 1.02; }

  /* ---------- Dispositivos ---------- */
  .dispositivos { grid-area: dispositivos; position: relative; aspect-ratio: 1.15; width: 100%; max-height: 74svh; justify-self: center; }
  /* El móvil: la pantalla tiene la proporción EXACTA de las capturas (390×844),
     así nada se recorta; el marco es un borde fino alrededor, como un móvil actual */
  .telefono {
    position: absolute; right: 0; top: 0; height: 100%; aspect-ratio: 404 / 858; z-index: 2; /* 390×844 + el marco */
    padding: 7px; border-radius: 44px; background: #0b0a09;
    box-shadow: 0 40px 70px -30px rgb(0 0 0 / 0.55), inset 0 0 0 1px rgb(255 255 255 / 0.1);
  }
  .pantalla-app { position: relative; width: 100%; height: 100%; border-radius: 37px; overflow: hidden; background: #121110; }
  .capa { position: absolute; inset: 0; overflow: hidden; }
  .capa :global(img) { width: 100%; height: auto; display: block; }
  .capa:not(.capa--larga) :global(img) { height: 100%; object-fit: contain; }
  .toque {
    position: absolute; width: 16%; aspect-ratio: 1; margin: -8% 0 0 -8%; border-radius: 50%; z-index: 3; pointer-events: none;
    background: rgb(255 255 255 / 0.35); border: 2px solid rgb(255 255 255 / 0.9); box-shadow: 0 0 0 6px rgb(0 0 0 / 0.12);
  }

  .tablet {
    position: absolute; left: 0; top: 4%; width: 82%; aspect-ratio: 4 / 3; padding: 1.6%;
    border-radius: 4.5%; background: #0b0a09; box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.5), inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }
  .cocina { width: 100%; height: 100%; border-radius: 3.2%; overflow: hidden; background: #121110; color: #f2eee6; container-type: inline-size; display: flex; flex-direction: column; }
  .cocina-barra { display: flex; align-items: center; gap: 4cqw; padding: 3cqw 4cqw; border-bottom: 1px solid #262320; font-size: 2.6cqw; }
  .cocina-logo { height: 4.6cqw; width: auto; filter: invert(1); } /* la Y original de Yaku, en blanco */
  .cocina-live { margin-left: auto; color: #8fe0a8; }
  .cocina-columnas { position: relative; flex-grow: 1; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2cqw; padding: 3cqw 4cqw; }
  .cocina-col p { margin: 0; font-size: 3cqw; text-transform: uppercase; letter-spacing: 0.04em; }
  .ticket {
    position: absolute; top: 10cqw; left: 4cqw; width: calc((100% - 8cqw - 4cqw) / 3);
    display: flex; flex-direction: column; gap: 1.6cqw; padding: 2.4cqw; border-radius: 2cqw;
    background: #f2eee6; color: #121110; font-size: 2.4cqw;
  }
  .ticket-cab { display: flex; justify-content: space-between; align-items: baseline; }
  .ticket-cab span:first-child { font-size: 3.4cqw; text-transform: uppercase; }
  .ticket-cab span:last-child { color: #6b645b; }
  .ticket-plato { margin: 0; font-size: 2.6cqw; }
  .ticket-boton { padding: 1.6cqw; border-radius: 1.4cqw; background: #f2b33d; text-align: center; font-weight: 600; }
  .b-serviert, .ticket--preparando .b-starten { display: none; }
  .ticket--preparando .b-serviert { display: inline; }
  .ticket--preparando .ticket-boton { background: #121110; color: #f2eee6; }

  /* Capturas claras u oscuras según el modo de la web (y oscuras en "modo cine") */
  .solo-oscuro { display: none !important; }
  :global(:root[data-theme='dark']) .solo-oscuro, :global(:root.cine) .solo-oscuro { display: block !important; }
  :global(:root[data-theme='dark']) .solo-claro, :global(:root.cine) .solo-claro { display: none !important; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .solo-oscuro { display: block !important; }
    :global(:root:not([data-theme='light'])) .solo-claro { display: none !important; }
  }

  /* ---------- Leyenda ---------- */
  .leyenda { grid-area: leyenda; align-self: end; display: flex; flex-direction: column; gap: var(--espacio-3); padding-top: var(--espacio-5); }
  .leyenda-pasos { display: grid; }
  .paso { grid-area: 1 / 1; margin: 0; }
  .paso span { color: var(--color-acento); }
  .yaku:not(.yaku--animado) .paso:not(:first-child) { display: none; }
  .progreso { height: 2px; border-radius: 2px; background: var(--color-linea); overflow: hidden; max-width: 22rem; }
  .progreso span { display: block; height: 100%; background: var(--color-acento); transform-origin: left; transform: scaleX(0); }

  /* Sin animación: la tablet ya enseña el ticket en preparación */
  .yaku:not(.yaku--animado) .ticket { left: calc(4cqw + (100% - 8cqw - 4cqw) / 3 + 2cqw); }
  .yaku:not(.yaku--animado) .b-starten { display: none; }
  .yaku:not(.yaku--animado) .b-serviert { display: inline; }

  @media (max-width: 900px) {
    .escena { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'texto' 'dispositivos' 'leyenda'; row-gap: var(--espacio-5); }
    .yaku--animado .escena { align-content: start; overflow: hidden; }
    .dispositivos { max-height: 46svh; aspect-ratio: 1; }
    .telefono { right: 2%; }
    .tablet { width: 80%; top: 6%; }
  }
</style>
