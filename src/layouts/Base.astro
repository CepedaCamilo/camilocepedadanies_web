---
// La plantilla que envuelve todas las páginas: <head>, cabecera y pie.
// El idioma sale de la dirección (/, /de, /es): ver src/i18n.ts
import '@fontsource-variable/geist'
import '@fontsource-variable/geist-mono'
import '../styles/tokens.css'
import '../styles/global.css'
import Cabecera from '../components/Cabecera.astro'
import Pie from '../components/Pie.astro'
import { sitio } from '../sitio'
import { idiomas, idiomaDe, sinIdioma, enlace, locales, t } from '../i18n'

interface Props {
  titulo?: string
  descripcion?: string
  idioma?: string // para páginas que no siguen /de /es (p. ej. Impressum en alemán)
}
const idiomaPagina = idiomaDe(Astro.url)
const textos = t(idiomaPagina, {
  en: { lema: 'Design & software', saltar: 'Skip to content' },
  de: { lema: 'Design & Software', saltar: 'Zum Inhalt springen' },
  es: { lema: 'Diseño y software', saltar: 'Saltar al contenido' },
})
const { titulo, descripcion = t(idiomaPagina, sitio.descripcion), idioma = idiomaPagina } = Astro.props
// En la pestaña y al compartir: "camilocepedadanies", junto, como el logo
const tituloCompleto = titulo ? `${titulo} — ${sitio.marca}` : `${sitio.marca} — ${textos.lema}`
// Direcciones completas (para compartir y para Google). La web se publica con SITE_URL (ver package.json)
const base = Astro.site ?? new URL('https://camilocepedadanies.com')
const camino = sinIdioma(Astro.url)
const imagen = new URL('/og.jpg', base).href
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/webclip.png" />
    <!-- Al compartir el enlace (WhatsApp, LinkedIn, Slack…): título, texto e imagen (public/og.jpg, 1200×630) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={sitio.marca} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={new URL(Astro.url.pathname, base).href} />
    <meta property="og:image" content={imagen} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locales[idiomaPagina]} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={imagen} />
    <!-- La misma página en los otros idiomas (para Google) -->
    {idiomas.map((i) => <link rel="alternate" hreflang={i} href={new URL(enlace(i, camino), base).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(camino, base).href} />
    <!-- Antes de pintar: aplicar el tema guardado, para que no parpadee -->
    <script is:inline>
      try {
        const tema = localStorage.getItem('tema')
        if (tema === 'light' || tema === 'dark') document.documentElement.dataset.theme = tema
      } catch {}
    </script>
    <!-- Primera visita a la portada en inglés: si el navegador está en alemán o español, abrir esa versión
         (solo si la persona aún no ha elegido idioma con el selector) -->
    <script is:inline>
      try {
        if (location.pathname === '/' && !localStorage.getItem('idioma')) {
          const n = (navigator.language || '').slice(0, 2)
          if (n === 'de' || n === 'es') { localStorage.setItem('idioma', n); location.replace('/' + n + location.hash) }
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="solo-lectores" href="#contenido">{textos.saltar}</a>
    <Cabecera />
    <main id="contenido">
      <slot />
    </main>
    <Pie />
  </body>
</html>
