---
// Una página por cada archivo de src/content/proyectos/. Se crean solas.
import { getCollection, render } from 'astro:content'
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import TransalpDispositivos from '../components/TransalpDispositivos.astro'

export async function getStaticPaths() {
  const proyectos = (await getCollection('proyectos', (p) => !p.data.oculto)).sort(
    (a, b) => a.data.orden - b.data.orden
  )
  return proyectos.map((proyecto, i) => ({
    params: { proyecto: proyecto.id },
    // el último caso no tiene "siguiente": vuelve a la portada (What I bring)
    props: { proyecto, siguiente: i < proyectos.length - 1 ? proyectos[i + 1] : null },
  }))
}

const { proyecto, siguiente } = Astro.props
const p = proyecto.data
const { Content } = await render(proyecto)
// "Título — subtítulo": el subtítulo va en su propia línea (así el título nunca se corta a mitad de frase)
const [titulo, subtitulo] = p.titulo.split(' — ')
---

<Base titulo={p.titulo} descripcion={p.resumen}>
  <article class="contenedor proyecto">
    <a class="etiqueta volver" href={p.tipo === 'software' ? '/#software' : '/#design'}>← All projects</a>

    <header class="cabecera-proyecto">
      <p class="etiqueta">{p.categoria}{p.año && ` · ${p.año}`}</p>
      <h1>{titulo}{subtitulo && <span class="subtitulo">{subtitulo}</span>}</h1>
      <p class="entradilla">{p.resumen}</p>
      <div class="meta">
        {p.cliente && <p class="etiqueta">Client · {p.cliente}</p>}
        {p.disciplinas.length > 0 && <ul class="chips">{p.disciplinas.map((d) => <li>{d}</li>)}</ul>}
      </div>
      {
        p.enlace && (
          <a class="pildora pildora--llena" href={p.enlace} rel="noopener">
            {p.textoEnlace ?? 'Visit'} ↗
          </a>
        )
      }
    </header>

    {/* Transalp: en lugar de una imagen, los dispositivos animados de la portada (se mueven solos) */}
    {proyecto.id === 'integrated-campaign-communication' && <div class="portada-escena"><TransalpDispositivos autoplay /></div>}
    {p.portada && <Image class="portada" src={p.portada} alt="" widths={[800, 1400, 2200]} sizes="(max-width: 1000px) 100vw, 960px" />}

    <div class="prosa">
      <Content />
    </div>

    {
      siguiente ? (
        <a class="siguiente" href={`/${siguiente.id}.html`}>
          <span class="etiqueta">Next project →</span>
          <span class="siguiente-titulo">{siguiente.data.titulo.split(' — ')[0]}</span>
        </a>
      ) : (
        <a class="siguiente" href="/#about">
          <span class="etiqueta">← Back to the start</span>
          <span class="siguiente-titulo">What I bring</span>
        </a>
      )
    }
  </article>
</Base>

<style>
  .proyecto { display: flex; flex-direction: column; gap: var(--espacio-7); padding-block: var(--espacio-6) var(--espacio-8); }
  .volver { text-decoration: none; }
  .cabecera-proyecto { display: flex; flex-direction: column; align-items: flex-start; gap: var(--espacio-5); max-width: 56rem; }
  .subtitulo { display: block; color: var(--color-texto-suave); }
  .meta { display: flex; flex-direction: column; gap: var(--espacio-3); }
  /* la imagen de cabecera mide lo mismo que las imágenes y vídeos del caso (60rem); si es un recorte sin fondo, algo menos */
  .portada { width: 100%; max-width: 60rem; border-radius: var(--radio-l); }
  .portada[src*="recorte"] { max-width: 40rem; border-radius: 0; }
  .portada-escena { width: 100%; max-width: 60rem; }
  .siguiente {
    display: flex; flex-direction: column; gap: var(--espacio-3);
    padding-top: var(--espacio-6); border-top: var(--linea-fina) solid var(--color-linea); text-decoration: none;
  }
  .siguiente-titulo { font-size: var(--titulo-2); font-weight: var(--peso-fino); letter-spacing: var(--tracking-titulo); line-height: 1.05; }
</style>
