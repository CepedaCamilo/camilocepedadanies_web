---
// Impressum (el idioma sale de la dirección: /impressum.html = EN, /de/… = DE, /es/… = ES). Texto: components/legal/Impressum.astro
import Base from '../../layouts/Base.astro'
import Impressum from '../../components/legal/Impressum.astro'
import { idiomaDe, t } from '../../i18n'
const titulo = t(idiomaDe(Astro.url), { en: 'Legal notice', de: 'Impressum', es: 'Aviso legal' })
---

<Base titulo={titulo}>
  <Impressum />
</Base>
