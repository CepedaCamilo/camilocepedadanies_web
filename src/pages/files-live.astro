---
// "Try it live" del caso 03 (Secure by default): el mismo móvil de la animación, pero de verdad.
// El código de 6 cifras llega DE VERDAD por email (Edge Function demo-codigo en mi servidor; no crea cuentas,
// guarda solo huellas y todo se borra a las 24 h). Los archivos, en cambio, nunca salen del navegador
// (se ven con un enlace local, URL.createObjectURL). Al recargar, vuelve a empezar.
import '@fontsource-variable/geist'
import '@fontsource-variable/geist-mono'
import '../styles/tokens.css'
import '../styles/global.css'
import { sitio } from '../sitio'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>Secure by default · live demo — {sitio.nombre}</title>
    <meta name="description" content="Receive a real one-time code by email, drop a file, share a link that expires. Your files never leave your browser." />
    <link rel="icon" href="/favicon.png" />
    <script is:inline>
      try {
        const tema = localStorage.getItem('tema')
        if (tema === 'light' || tema === 'dark') document.documentElement.dataset.theme = tema
      } catch {}
    </script>
  </head>
  <body>
    <header class="arriba">
      <a class="etiqueta volver" href="/#caso-archivos">← Back to the case</a>
      <a class="logo" href="/" aria-label="Camilo Cepeda Danies — home"><b>camilo</b><span>cepeda</span><b>danies</b></a>
    </header>

    <main class="lienzo">
      <div class="telefono">
        <div class="barra">
          <span class="etiqueta">files.danies.trade · demo</span>
          <span class="etiqueta seguro">● Encrypted · DE</span>
        </div>
        <h1 class="titulo-app">Files</h1>

        <div class="cuerpo">
          <!-- 1. Email -->
          <form class="vista" data-vista="login" data-form-email data-api={sitio.demoCodigo.api} data-clave={sitio.demoCodigo.clave}>
            <p class="etiqueta">Secure sign-in</p>
            <p class="explica">Enter your email and you will receive a 6-digit code to verify it.</p>
            <label class="solo-lectores" for="email">Email</label>
            <input class="campo" id="email" type="email" required maxlength="254" placeholder="Your email" autocomplete="email" data-email />
            <button class="boton" type="submit">Send code</button>
            <p class="error etiqueta" data-error-email aria-live="polite"></p>
            <p class="etiqueta pista">Used only for this demo · stored as an unreadable fingerprint · deleted after 24 h · <a href="/datenschutz.html#demo">Privacy</a></p>
          </form>

          <!-- 2. Código -->
          <form class="vista" data-vista="codigo" data-form-codigo hidden>
            <div class="aviso-mail" data-aviso>
              <span class="etiqueta">Mail · now</span>
              <span>Check your inbox — the code is valid for 10 minutes.</span>
            </div>
            <p class="etiqueta">Enter the 6-digit code sent to <span data-email-eco></span></p>
            <label class="casillas" data-casillas>
              <span class="solo-lectores">6-digit code</span>
              <input data-codigo inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]*" />
              <span class="casilla"></span><span class="casilla"></span><span class="casilla"></span>
              <span class="casilla"></span><span class="casilla"></span><span class="casilla"></span>
            </label>
            <p class="error etiqueta" data-error aria-live="polite"></p>
            <button class="boton" type="submit">Verify</button>
            <p class="etiqueta pista">No email? Check your spam folder · <button type="button" class="enlace-texto" data-reenviar>Send a new code</button> · <button type="button" class="enlace-texto" data-otro-email>Use another email</button></p>
          </form>

          <!-- 3. Espacio privado -->
          <div class="vista vista--espacio" data-vista="espacio" hidden>
            <div class="fila">
              <p class="etiqueta">My files</p>
              <button class="etiqueta salir" type="button" data-salir>Sign out</button>
            </div>
            <label class="zona" data-zona>
              <input type="file" accept="image/*,application/pdf" multiple data-input-archivo class="solo-lectores" />
              <span>Drop files here</span>
              <span class="etiqueta">or click to choose · images & PDF · max. 10 MB</span>
            </label>
            <p class="error etiqueta" data-error-archivo aria-live="polite"></p>
            <ul class="lista" data-lista></ul>
          </div>
        </div>
      </div>
      <p class="etiqueta nota">Demo — the code is sent by email; your files never leave this browser and nothing is uploaded. Reload to start again.</p>
    </main>

    <footer class="abajo etiqueta">
      <a href="/impressum.html">Legal notice</a>
      <a href="/datenschutz.html">Privacy</a>
    </footer>

    <script>
      const MAXIMO = 10 * 1024 * 1024 // 10 MB, como en la app real
      const DURACION = 60 // segundos del enlace en la demo (en la app real: 1 hora)

      const vista = (id: string) => document.querySelector<HTMLElement>(`[data-vista="${id}"]`)!
      const mostrar = (id: string) => {
        document.querySelectorAll<HTMLElement>('[data-vista]').forEach((v) => (v.hidden = v.dataset.vista !== id))
        const v = vista(id); v.classList.remove('entra'); void v.offsetWidth; v.classList.add('entra')
      }
      const pulsar = (b: HTMLElement) => { b.classList.remove('pulsado'); void b.offsetWidth; b.classList.add('pulsado') }

      // 1. Email → código
      const formEmail = document.querySelector<HTMLFormElement>('[data-form-email]')!
      const email = document.querySelector<HTMLInputElement>('[data-email]')!
      const codigo = document.querySelector<HTMLInputElement>('[data-codigo]')!
      const casillas = document.querySelectorAll<HTMLElement>('.casilla')
      const error = document.querySelector<HTMLElement>('[data-error]')!
      const errorEmail = document.querySelector<HTMLElement>('[data-error-email]')!

      // La "ventanilla" del servidor: envía y comprueba los códigos (clave pública, nunca la secreta)
      async function ventanilla(datos: Record<string, string>) {
        try {
          const r = await fetch(formEmail.dataset.api!, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', apikey: formEmail.dataset.clave!, Authorization: `Bearer ${formEmail.dataset.clave}` },
            body: JSON.stringify(datos),
          })
          const cuerpo = await r.json().catch(() => ({}))
          return r.ok ? { ok: true } : { ok: false, error: cuerpo.error ?? 'Something went wrong. Please try again.' }
        } catch {
          return { ok: false, error: 'No connection. Please try again.' }
        }
      }
      // Botón ocupado: se desactiva y dice qué está pasando
      const ocupado = (b: HTMLButtonElement, texto: string | null) => {
        if (texto) { b.dataset.texto ??= b.textContent!; b.textContent = texto; b.disabled = true }
        else { b.textContent = b.dataset.texto ?? b.textContent; b.disabled = false }
      }

      async function enviarCodigo(boton: HTMLButtonElement, avisoEn: HTMLElement) {
        ocupado(boton, 'Sending…')
        const r = await ventanilla({ accion: 'enviar', email: email.value.trim() })
        ocupado(boton, null)
        if (!r.ok) { avisoEn.textContent = r.error!; avisoEn.classList.remove('bien'); return false }
        return true
      }

      formEmail.addEventListener('submit', async (e) => {
        e.preventDefault()
        pulsar(formEmail.querySelector('button')!)
        errorEmail.textContent = ''
        if (!(await enviarCodigo(formEmail.querySelector('button')!, errorEmail))) return
        document.querySelector('[data-email-eco]')!.textContent = email.value.trim()
        mostrar('codigo')
        codigo.value = ''; pintarCasillas(); error.textContent = ''; error.classList.remove('bien')
        if (matchMedia('(pointer: fine)').matches) codigo.focus()
      })

      // 2. Código: 6 casillas redondas que se rellenan (por dentro es un solo campo)
      const pintarCasillas = () => {
        codigo.value = codigo.value.replace(/\D/g, '').slice(0, 6)
        casillas.forEach((c, i) => {
          c.textContent = codigo.value[i] ?? ''
          c.classList.toggle('llena', i < codigo.value.length)
          c.classList.toggle('activa', i === Math.min(codigo.value.length, 5) && document.activeElement === codigo)
        })
      }
      codigo.addEventListener('input', pintarCasillas)
      codigo.addEventListener('focus', pintarCasillas)
      codigo.addEventListener('blur', pintarCasillas)
      const formCodigo = document.querySelector<HTMLFormElement>('[data-form-codigo]')!
      const temblar = () => {
        const c = formCodigo.querySelector('[data-casillas]')!
        c.classList.remove('tiembla'); void (c as HTMLElement).offsetWidth; c.classList.add('tiembla')
      }
      document.querySelector('[data-reenviar]')!.addEventListener('click', async (e) => {
        if (await enviarCodigo(e.currentTarget as HTMLButtonElement, error)) {
          codigo.value = ''; pintarCasillas()
          error.textContent = 'A new code is on its way.'; error.classList.add('bien')
        }
      })
      document.querySelector('[data-otro-email]')!.addEventListener('click', () => { mostrar('login'); email.focus() })

      formCodigo.addEventListener('submit', async (e) => {
        e.preventDefault()
        const boton = formCodigo.querySelector<HTMLButtonElement>('button[type=submit]')!
        pulsar(boton)
        if (codigo.value.length !== 6) { error.textContent = 'The code has 6 digits.'; error.classList.remove('bien'); temblar(); return }
        ocupado(boton, 'Verifying…')
        const r = await ventanilla({ accion: 'verificar', email: email.value.trim(), codigo: codigo.value })
        ocupado(boton, null)
        if (!r.ok) {
          error.textContent = r.error!; error.classList.remove('bien')
          temblar()
          return
        }
        casillas.forEach((c) => c.classList.add('ok'))
        error.textContent = '✓ Identity verified'; error.classList.add('bien')
        setTimeout(() => { casillas.forEach((c) => c.classList.remove('ok')); mostrar('espacio') }, 600)
      })

      // 3. Archivos: arrastrar y soltar (o elegir), "subida", Private, enlace que caduca
      const zona = document.querySelector<HTMLElement>('[data-zona]')!
      const input = document.querySelector<HTMLInputElement>('[data-input-archivo]')!
      const lista = document.querySelector<HTMLElement>('[data-lista]')!
      const errorArchivo = document.querySelector<HTMLElement>('[data-error-archivo]')!
      const urls: string[] = []

      const peso = (b: number) => (b > 1024 * 1024 ? `${(b / 1024 / 1024).toFixed(1)} MB` : `${Math.max(1, Math.round(b / 1024))} KB`)
      const crear = (tag: string, clase?: string, texto?: string) => {
        const e = document.createElement(tag); if (clase) e.className = clase; if (texto) e.textContent = texto; return e
      }

      function añadir(archivo: File) {
        const esImagen = archivo.type.startsWith('image/')
        if (!esImagen && archivo.type !== 'application/pdf') return `${archivo.name}: only images and PDF`
        if (archivo.size > MAXIMO) return `${archivo.name}: larger than 10 MB`
        const li = crear('li', 'archivo')
        let mini: HTMLElement
        if (esImagen) {
          const url = URL.createObjectURL(archivo); urls.push(url)
          mini = crear('img', 'mini'); (mini as HTMLImageElement).src = url; (mini as HTMLImageElement).alt = ''
        } else mini = crear('span', 'mini mini--pdf', 'PDF')
        const datos = crear('div', 'archivo-datos')
        datos.append(crear('span', 'nombre', archivo.name), crear('span', 'etiqueta', peso(archivo.size)))
        const barra = crear('span', 'barra-subida'); const relleno = crear('span'); barra.append(relleno); datos.append(barra)
        const estado = crear('span', 'privado', 'Uploading…')
        li.append(mini, datos, estado)
        lista.prepend(li)
        // "Subida" de mentira: la barra se llena y aparece el candado
        requestAnimationFrame(() => (relleno.style.transform = 'scaleX(1)'))
        setTimeout(() => {
          barra.remove(); estado.textContent = '🔒 Private'; estado.classList.add('listo')
          const compartir = crear('button', 'compartir etiqueta', 'Create secure link') as HTMLButtonElement
          compartir.type = 'button'
          compartir.addEventListener('click', () => enlace(li, compartir))
          datos.append(compartir)
        }, 1300)
        return null
      }

      function enlace(li: HTMLElement, boton: HTMLButtonElement) {
        boton.remove()
        const e = crear('li', 'enlace')
        const reloj = (n: number) => `${Math.floor(n / 60)}:${String(n % 60).padStart(2, '0')}`
        const tiempo = crear('b', undefined, reloj(DURACION))
        e.append(crear('span', 'etiqueta', 'Secure link'), crear('span', 'enlace-tiempo', 'expires in '))
        e.lastElementChild!.append(tiempo)
        li.after(e)
        let quedan = DURACION
        const intervalo = setInterval(() => {
          quedan--
          tiempo.textContent = reloj(quedan)
          if (quedan <= 0) {
            clearInterval(intervalo)
            e.classList.add('enlace--caducado')
            e.lastElementChild!.textContent = 'Expired — nobody can open it now'
          }
        }, 1000)
      }

      function recibir(archivos: FileList | null) {
        if (!archivos) return
        const errores = [...archivos].map(añadir).filter(Boolean)
        errorArchivo.textContent = errores.join(' · ')
      }
      input.addEventListener('change', () => { recibir(input.files); input.value = '' })
      ;['dragenter', 'dragover'].forEach((t) => zona.addEventListener(t, (e) => { e.preventDefault(); zona.classList.add('encendida') }))
      ;['dragleave', 'drop'].forEach((t) => zona.addEventListener(t, () => zona.classList.remove('encendida')))
      zona.addEventListener('drop', (e) => { e.preventDefault(); recibir((e as DragEvent).dataTransfer?.files ?? null) })

      document.querySelector('[data-salir]')!.addEventListener('click', () => {
        urls.forEach((u) => URL.revokeObjectURL(u)); urls.length = 0
        lista.textContent = ''; errorArchivo.textContent = ''; email.value = ''
        mostrar('login')
      })
    </script>

    <style>
      body { min-height: 100svh; display: flex; flex-direction: column; background: var(--color-fondo); }
      .arriba, .abajo { display: flex; justify-content: space-between; align-items: center; gap: var(--espacio-4); padding: var(--espacio-4); }
      .volver { text-decoration: none; }
      .logo { font-family: var(--fuente-mono); font-size: var(--texto-s); text-decoration: none; color: var(--color-texto); }
      .logo b { font-weight: 700; }
      .logo span { font-weight: 300; }
      .abajo { justify-content: center; gap: var(--espacio-5); }
      .abajo a { color: var(--color-texto-suave); }
      .lienzo { flex-grow: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: var(--espacio-4); padding-inline: var(--espacio-4); }
      .nota { max-width: 26rem; text-align: center; color: var(--color-texto-suave); }

      /* El mismo "móvil" que el chat */
      .telefono {
        width: min(100%, 26rem); height: min(78svh, 46rem); display: flex; flex-direction: column; gap: 0.9rem;
        padding: 1.6rem 1.3rem 1.3rem; border-radius: 2.6rem;
        background: var(--color-superficie); border: var(--linea-fina) solid var(--color-linea);
        box-shadow: 0 40px 80px -30px rgb(35 26 21 / 0.35); font-size: 0.95rem;
      }
      .barra { display: flex; justify-content: space-between; }
      .barra .etiqueta { font-size: 0.8em; }
      .seguro { color: var(--color-acento); }
      .titulo-app { margin: 0; font-size: 2.6em; font-weight: var(--peso-fino); letter-spacing: var(--tracking-titulo); line-height: 1; }
      .cuerpo { position: relative; flex-grow: 1; min-height: 0; border-radius: 1.6em; background: var(--color-fondo); overflow: hidden; }
      .vista { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: center; gap: 0.9em; padding: 1.1em; margin: 0; }
      .vista[hidden] { display: none; }
      .vista.entra { animation: entra 0.35s ease; }
      @keyframes entra { from { opacity: 0; transform: translateX(8%); } }
      .vista .etiqueta { font-size: 0.8em; margin: 0; }
      .vista--espacio { justify-content: flex-start; overflow-y: auto; scrollbar-width: none; }
      .pista { text-align: center; color: var(--color-texto-suave); }

      .campo {
        padding: 0.9em 1.1em; border: 0; border-radius: 999px; outline: 0; font: inherit; font-size: max(16px, 1em);
        background: var(--color-invertido); color: var(--color-sobre-invertido);
      }
      .campo::placeholder { color: inherit; opacity: 0.7; }
      .campo:focus-visible { box-shadow: 0 0 0 2px var(--color-acento); }
      .boton {
        padding: 0.85em 1.1em; border: 0; border-radius: 999px; cursor: pointer;
        font: var(--peso-medio) 1em / 1 var(--fuente-texto); background: var(--color-acento); color: var(--color-sobre-acento);
      }
      .boton.pulsado, .pulsado { animation: pulsar 0.5s ease; }
      @keyframes pulsar {
        25% { transform: scale(0.94); background: var(--color-sobre-invertido); color: var(--color-invertido); }
        60% { transform: scale(1.02); background: var(--color-sobre-invertido); color: var(--color-invertido); }
      }

      .aviso-mail { display: flex; flex-direction: column; gap: 0.2em; padding: 0.75em 1em; border-radius: 1.3em; background: var(--color-superficie-2); animation: baja 0.4s cubic-bezier(0.34, 1.56, 0.64, 1); }
      @keyframes baja { from { opacity: 0; transform: translateY(-60%); } }
      .aviso-mail b { font-family: var(--fuente-mono); letter-spacing: 0.08em; }
      .casillas { position: relative; display: grid; grid-template-columns: repeat(6, 1fr); gap: 0.45em; cursor: text; }
      .casillas input { position: absolute; inset: 0; opacity: 0; font-size: 16px; }
      .casilla {
        aspect-ratio: 0.8; display: grid; place-items: center; border-radius: 999px; font-family: var(--fuente-mono); font-size: 1.25em;
        border: var(--linea-fina) solid var(--color-linea); transition: border-color 0.2s, background-color 0.2s;
      }
      .casilla.llena { border-color: var(--color-acento); background: var(--color-superficie-2); }
      .casilla.activa { border-color: var(--color-acento); box-shadow: 0 0 0 2px color-mix(in srgb, var(--color-acento) 30%, transparent); }
      .casilla.ok { background: var(--color-acento); color: var(--color-sobre-acento); }
      .tiembla { animation: tiembla 0.4s; }
      @keyframes tiembla { 20%, 60% { transform: translateX(-6px); } 40%, 80% { transform: translateX(6px); } }
      .error { color: #d4502e; min-height: 1em; }
      .error.bien { color: var(--color-acento); }
      .explica { margin: 0; line-height: 1.4; }
      .pista a, .enlace-texto { color: inherit; text-decoration: underline; }
      .enlace-texto { padding: 0; border: 0; background: none; font: inherit; cursor: pointer; }
      .enlace-texto:disabled { opacity: 0.5; cursor: default; }
      .boton:disabled { opacity: 0.7; cursor: default; }

      .fila { display: flex; justify-content: space-between; align-items: center; }
      .salir { border: 0; background: none; cursor: pointer; color: var(--color-texto-suave); text-decoration: underline; }
      .zona {
        display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.3em; min-height: 7.5em; flex-shrink: 0;
        border-radius: 1.3em; text-align: center; cursor: pointer; border: 1.5px dashed var(--color-linea);
        transition: border-color 0.2s, background-color 0.2s;
      }
      .zona:hover, .zona.encendida { border-color: var(--color-acento); background: color-mix(in srgb, var(--color-acento) 12%, transparent); }
      .zona:focus-within { border-color: var(--color-acento); }
      .lista { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.6em; }
      .lista :global(.archivo) {
        display: grid; grid-template-columns: 3.2em minmax(0, 1fr) auto; align-items: center; gap: 0.8em;
        padding: 0.6em; border-radius: 1.3em; background: var(--color-superficie-2); animation: entra 0.3s ease;
      }
      .lista :global(.mini) { width: 3.2em; height: 3.2em; border-radius: 0.9em; object-fit: cover; }
      .lista :global(.mini--pdf) { display: grid; place-items: center; background: var(--color-invertido); color: var(--color-sobre-invertido); font-family: var(--fuente-mono); font-size: 0.8em; }
      .lista :global(.archivo-datos) { display: flex; flex-direction: column; gap: 0.25em; min-width: 0; }
      .lista :global(.nombre) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .lista :global(.barra-subida) { height: 0.3em; border-radius: 999px; background: var(--color-linea); overflow: hidden; }
      .lista :global(.barra-subida span) { display: block; height: 100%; background: var(--color-acento); transform-origin: left; transform: scaleX(0); transition: transform 1.2s ease; }
      .lista :global(.privado) { padding: 0.4em 0.8em; border-radius: 999px; font-size: 0.8em; font-weight: var(--peso-medio); background: var(--color-linea); }
      .lista :global(.privado.listo) { background: var(--color-invertido); color: var(--color-sobre-invertido); }
      .lista :global(.compartir) { align-self: flex-start; padding: 0; border: 0; background: none; cursor: pointer; color: var(--color-acento); text-decoration: underline; }
      .lista :global(.enlace) {
        display: flex; justify-content: space-between; align-items: center; gap: 0.6em; padding: 0.75em 1em; border-radius: 999px;
        background: var(--color-acento); color: var(--color-sobre-acento); animation: entra 0.3s ease; transition: background-color 0.3s, color 0.3s;
      }
      .lista :global(.enlace .etiqueta) { color: inherit; opacity: 0.8; }
      .lista :global(.enlace b) { font-family: var(--fuente-mono); font-weight: var(--peso-medio); }
      .lista :global(.enlace--caducado) { background: var(--color-superficie-2); color: var(--color-texto-suave); }

      @media (max-width: 520px) {
        .lienzo { padding-inline: var(--espacio-3); }
        .telefono { height: calc(100svh - 9.5rem); border-radius: 2rem; padding: 1.2rem 1rem 1rem; }
      }
      @media (prefers-reduced-motion: reduce) {
        .vista.entra, .pulsado, .aviso-mail, .tiembla, .lista :global(*) { animation: none !important; }
      }
    </style>
  </body>
</html>
