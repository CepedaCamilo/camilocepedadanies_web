---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import TarjetaProyecto from '../components/TarjetaProyecto.astro'
import Hero from '../components/Hero.astro'
import Cine from '../components/Cine.astro'
import { sitio } from '../sitio'
import escaladores from '../assets/marca/escaladores.png'

// Todos los proyectos visibles, ordenados por el campo "orden"
const proyectos = (await getCollection('proyectos', (p) => !p.data.oculto)).sort(
  (a, b) => a.data.orden - b.data.orden
)
const diseño = proyectos.filter((p) => p.data.tipo === 'design')
const software = proyectos.filter((p) => p.data.tipo === 'software')

// Preguntas de "Core expertise" (texto original de la web anterior)
const preguntas = [
  {
    q: 'What kind of projects do I specialize in?',
    a: 'I work across licensed product design, brand identity systems, motion media, commercial photography, UI concepts and AI-enhanced visual production. My focus is always on projects that require both strong aesthetics and strategic communication.',
  },
  {
    q: 'Do I work only with one design discipline?',
    a: 'No. My work is intentionally multidisciplinary. Depending on the project, I combine branding, product development, media editing, photography, digital interfaces and AI-supported workflows to achieve the strongest result.',
  },
  {
    q: 'International experience & collaboration',
    a: 'Based in Hamburg, my work has been developed across European and international contexts, adapting visual communication to different industries, audiences and market expectations.',
  },
  {
    q: 'How do I approach a new creative challenge?',
    a: 'Every project starts with identifying the problem, the audience and the business objective behind it. From there, I build solutions that are not only visually refined, but also practical, scalable and purpose-driven.',
  },
  {
    q: 'How does AI support my workflow?',
    a: 'AI is used as an enhancement tool for faster ideation, visual prototyping, advanced image generation and modern content production — always combined with human creative direction and design control.',
  },
  {
    q: 'What makes the final output stand out?',
    a: 'Each project is built around clarity, modern execution and strategic intention — creating visual results that are not only attractive, but durable, purposeful and commercially strong.',
  },
]
---

<Base>
  <Hero />
  <Cine />

  <!-- DISEÑO -->
  <section id="work" class="seccion contenedor">
    <header class="cabecera-seccion">
      <p class="etiqueta">01 · Selected design work</p>
      <h2>Brands, products and campaigns.</h2>
    </header>
    <div class="rejilla">
      {diseño.map((p) => <TarjetaProyecto proyecto={p} />)}
    </div>
  </section>

  <!-- SOFTWARE -->
  <section id="building" class="seccion seccion--software">
    <div class="contenedor">
      <header class="cabecera-seccion">
        <p class="etiqueta">02 · Now building</p>
        <h2>From designer to software builder.</h2>
        <p class="entradilla">
          Since 2026 I design and build my own web apps and run them on my own server in Nürnberg:
          sign-in, files, realtime chat and an admin panel. Every project below is live.
        </p>
      </header>
      <div class="rejilla">
        {software.map((p) => <TarjetaProyecto proyecto={p} />)}
      </div>
    </div>
  </section>

  <!-- SOBRE MÍ -->
  <section id="about" class="seccion contenedor sobre-mi">
    <div class="sobre-mi-texto">
      <p class="etiqueta">03 · Core expertise</p>
      <h2>A multidisciplinary creative approach.</h2>
      <p class="entradilla">
        With 8+ years of experience, I build visual systems across licensed product development, motion
        campaigns, corporate branding and AI-supported narrative production — always guided by strategic
        clarity and communication purpose.
      </p>
      <Image class="ilustracion" src={escaladores} alt="" widths={[600, 1000]} sizes="(max-width: 900px) 100vw, 40vw" />
    </div>
    <div class="preguntas">
      {
        preguntas.map((p, i) => (
          <details>
            <summary>
              <span class="etiqueta">{String(i + 1).padStart(2, '0')}</span>
              <span>{p.q}</span>
            </summary>
            <p>{p.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- CONTACTO -->
  <section id="contact" class="seccion contenedor contacto">
    <p class="etiqueta">04 · Contact</p>
    <h2>Something meaningful?</h2>
    <a class="pildora pildora--llena pildora--grande" href={`mailto:${sitio.email}`}>Let's connect ↗</a>
    <p class="etiqueta">{sitio.email}</p>
  </section>
</Base>

<style>
  /* SECCIONES */
  .cabecera-seccion { display: flex; flex-direction: column; gap: var(--espacio-4); margin-bottom: var(--espacio-7); }
  .seccion--software { background: var(--color-superficie); border-radius: var(--radio-l); }
  @media (min-width: 1300px) { .seccion--software { margin-inline: var(--margen-lateral); } }

  /* SOBRE MÍ */
  .sobre-mi { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--espacio-7); }
  .sobre-mi-texto { display: flex; flex-direction: column; gap: var(--espacio-5); }
  .ilustracion { width: 100%; margin-top: var(--espacio-5); }
  :global(:root[data-theme='dark']) .ilustracion { filter: invert(1); }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme='light'])) .ilustracion { filter: invert(1); } }

  .preguntas { border-top: var(--linea-fina) solid var(--color-linea); align-self: start; }
  details { border-bottom: var(--linea-fina) solid var(--color-linea); }
  summary {
    display: flex; gap: var(--espacio-4); align-items: baseline;
    padding-block: var(--espacio-4); cursor: pointer; list-style: none;
    font-size: var(--texto-l); letter-spacing: -0.01em;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; margin-left: auto; font-family: var(--fuente-mono); color: var(--color-texto-suave); }
  details[open] summary::after { content: '−'; }
  details p { padding: 0 0 var(--espacio-5) calc(var(--espacio-4) + 2ch); color: var(--color-texto-suave); }

  /* CONTACTO */
  .contacto { display: flex; flex-direction: column; align-items: flex-start; gap: var(--espacio-5); }
  .pildora--grande { font-size: var(--titulo-3); padding: var(--espacio-4) var(--espacio-6); min-height: 60px; }

  @media (max-width: 900px) {
    .sobre-mi { grid-template-columns: minmax(0, 1fr); }
  }
</style>
