---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import Trabajos from '../components/Trabajos.astro'
import Hero from '../components/Hero.astro'
import Cine from '../components/Cine.astro'
import { sitio } from '../sitio'
import escaladores from '../assets/marca/escaladores.png'

// Todos los proyectos visibles, ordenados por el campo "orden"
const proyectos = (await getCollection('proyectos', (p) => !p.data.oculto)).sort(
  (a, b) => a.data.orden - b.data.orden
)
const diseño = proyectos.filter((p) => p.data.tipo === 'design')
const software = proyectos.filter((p) => p.data.tipo === 'software')

// "Core expertise": las tres áreas y las preguntas (textos de Camilo, sep 2026)
const areas = [
  { t: 'Brand & Product', d: 'Identity systems, licensed products, packaging and retail experiences built for real-world markets.' },
  { t: 'Digital Product', d: 'Interfaces and working web applications — from product thinking and design to front-end and back-end.' },
  { t: 'Creative Direction', d: 'Campaigns, storytelling, motion, photography and AI-supported visual production.' },
]
const preguntas = [
  {
    q: 'Do I only design, or do I also build?',
    a: 'Both. My background is in design and creative direction, and I now build digital products as well — working across interface design, front-end, back-end and deployment.',
  },
  {
    q: 'How do I turn an idea into a finished product?',
    a: 'Step by step, from understanding to making. I define the problem and the audience, shape the concept and the visual system, prototype early — then build, test and refine until it works in the real world, whether that is a product on a shelf or an application on a server.',
  },
  {
    q: 'What connects such different disciplines?',
    a: 'Systems thinking. Whether it is a brand, a physical product, a campaign or an application, I look for consistency between concept, function, visual language and execution.',
  },
  {
    q: 'How do I approach a new project?',
    a: 'I start with the problem, not the medium. The goal is to understand what needs to work, what needs to communicate and what the user should experience — then choose the right combination of design, technology and production.',
  },
  {
    q: 'Where does AI fit into my work?',
    a: 'As a production and exploration tool — not a substitute for direction. I use generative tools for visual development, storytelling and creative production while keeping concept, art direction and editorial decisions human.',
  },
]
---

<Base>
  <Hero />
  <Cine />

  <!-- DISEÑO -->
  <Trabajos diseño={diseño} software={software} />

  <!-- SOBRE MÍ -->
  <section id="about" class="seccion contenedor sobre-mi">
    <header class="sobre-mi-cabecera">
      <p class="etiqueta">Practice</p>
      <h2>What I bring</h2>
      <p class="entradilla">A multidisciplinary practice across three connected areas: brand, product and digital experiences.</p>
    </header>
    <div class="sobre-mi-columnas">
      <dl class="areas">
        {areas.map((a) => <div><dt>{a.t}</dt><dd>{a.d}</dd></div>)}
      </dl>
      <div class="preguntas">
        {
          preguntas.map((p, i) => (
            <details>
              <summary>
                <span class="etiqueta">{String(i + 1).padStart(2, '0')}</span>
                <span>{p.q}</span>
              </summary>
              <p>{p.a}</p>
            </details>
          ))
        }
      </div>
    </div>
    <p class="lema">From concept to production.<br />From visual system to working product.</p>
  </section>

  <!-- CONTACTO -->
  <section id="contact" class="seccion contenedor contacto">
    <div class="contacto-texto">
      <p class="etiqueta">Contact</p>
      <h2>Something meaningful?</h2>
      <a class="pildora pildora--llena pildora--grande" href={`mailto:${sitio.email}`}>Let's connect ↗</a>
      <p class="etiqueta">{sitio.email}</p>
    </div>
    <!-- los montañistas, subiendo juntos hacia "Let's connect": abajo del todo, siempre enteros -->
    <Image class="ilustracion" src={escaladores} alt="" widths={[700, 1200]} sizes="(max-width: 900px) 92vw, 620px" />
  </section>
</Base>

<script>
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  // Modo contraste: mientras "Core expertise" ocupa el centro de la pantalla, la página pasa al modo contrario
  // (Light → Dark, Dark → Light). Los colores de cada caso están en tokens.css (".contraste").
  ScrollTrigger.create({
    trigger: '#about',
    start: 'top 55%',
    end: 'bottom 45%',
    onToggle: (st) => document.documentElement.classList.toggle('contraste', st.isActive),
  })
</script>

<style>
  /* SECCIONES */
  .cabecera-seccion { display: flex; flex-direction: column; gap: var(--espacio-4); margin-bottom: var(--espacio-7); }

  /* SOBRE MÍ ("Practice"): cabecera centrada → dos columnas a la misma altura → lema centrado → dibujo centrado */
  .sobre-mi { display: flex; flex-direction: column; align-items: center; gap: var(--espacio-7); }
  .sobre-mi-cabecera { display: flex; flex-direction: column; align-items: center; gap: var(--espacio-4); max-width: 38rem; text-align: center; }
  .sobre-mi-columnas { width: 100%; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--espacio-7); align-items: stretch; } /* las dos columnas empiezan y terminan en la misma línea */

  /* las tres áreas: filas con línea fina, como la ficha de los casos (misma altura de fila que las preguntas) */
  .areas { margin: 0; display: flex; flex-direction: column; border-top: var(--linea-fina) solid var(--color-linea); }
  .areas div { flex: 1; display: grid; grid-template-columns: 11rem minmax(0, 1fr); align-content: start; gap: var(--espacio-4); padding-block: var(--espacio-4); border-bottom: var(--linea-fina) solid var(--color-linea); }
  .areas dt { font-size: var(--texto-l); letter-spacing: -0.01em; }
  .areas dd { margin: 0; color: var(--color-texto-suave); }
  .lema { margin: 0; text-align: center; font-size: var(--titulo-3); font-weight: var(--peso-fino); letter-spacing: -0.02em; line-height: 1.3; }
  @media (max-width: 600px) { .areas div { grid-template-columns: minmax(0, 1fr); gap: var(--espacio-1); } }

  .preguntas { border-top: var(--linea-fina) solid var(--color-linea); align-self: start; }
  details { border-bottom: var(--linea-fina) solid var(--color-linea); }
  summary {
    display: flex; gap: var(--espacio-4); align-items: baseline;
    padding-block: var(--espacio-4); cursor: pointer; list-style: none;
    font-size: var(--texto-l); letter-spacing: -0.01em;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; margin-left: auto; font-family: var(--fuente-mono); color: var(--color-texto-suave); }
  details[open] summary::after { content: '−'; }
  details p { padding: 0 0 var(--espacio-5) calc(var(--espacio-4) + 2ch); color: var(--color-texto-suave); }

  /* CONTACTO */
  .contacto { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); align-items: end; gap: var(--espacio-7); }
  .contacto-texto { display: flex; flex-direction: column; align-items: flex-start; gap: var(--espacio-5); }
  .ilustracion { width: 100%; max-width: 620px; justify-self: end; filter: var(--filtro-dibujo); }
  @media (max-width: 900px) {
    .contacto { grid-template-columns: minmax(0, 1fr); }
    .ilustracion { justify-self: center; }
  }
  .pildora--grande { font-size: var(--titulo-3); padding: var(--espacio-4) var(--espacio-6); min-height: 60px; }

  @media (max-width: 900px) {
    .sobre-mi-columnas { grid-template-columns: minmax(0, 1fr); }
  }
</style>
